# Preserve exact patch bytes; diff context prefixes are not source whitespace.
# CI checks the applied source separately.
host-patches/**/*.patch -text whitespace=-blank-at-eol,-space-before-tab
# Runtime helper digest is verified before launch on both development and CI checkouts.
experiments/code-mode-runtime/native/*.cs text eol=lf
experiments/code-mode-runtime/native/*.mjs text eol=lf
openai-compatibility/runtime/native/*.cs text eol=lf
openai-compatibility/runtime/native/*.mjs text eol=lf
host-patches/pi-0.85.1/LICENSE.pi text eol=lf
openai-compatibility/runtime/native/*.json text eol=lf
# Installed acceptance compares these scoped grants with canonical source bytes.
distribution/LICENSE text eol=lf
distribution/NOTICE text eol=lf
host-patches/LICENSE text eol=lf
host-patches/NOTICE text eol=lf
# Supplemental grants retain reviewed upstream bytes, including original line endings.
distribution/notices/LICENSE.* -text
# Preserve the upstream grant's space-only line and final blank line, not normalized text.
distribution/notices/LICENSE.emscripten whitespace=-blank-at-eol,-blank-at-eof
# This unchanged upstream header witness retains two trailing spaces in documentation.
distribution/notices/LICENSE.source-emscripten-header-03-emscripten whitespace=-blank-at-eol
# Exact upstream QuickJS witnesses retain only their observed whitespace exceptions.
distribution/notices/LICENSE.source-quickjs-core-01-cutils whitespace=-blank-at-eol
distribution/notices/LICENSE.source-quickjs-core-03-engine-header whitespace=-blank-at-eol
distribution/notices/LICENSE.source-quickjs-core-04-engine whitespace=-blank-at-eol
distribution/notices/LICENSE.source-quickjs-core-06-regexp whitespace=-blank-at-eol
distribution/notices/LICENSE.source-quickjs-core-11-libc whitespace=-blank-at-eol,-blank-at-eof
# Curation proof is compared byte-for-byte against matching trusted source.
distribution/payload-policy.json text eol=lf
docs/openai-integration/LICENSE text eol=lf
docs/openai-integration/NOTICE text eol=lf
