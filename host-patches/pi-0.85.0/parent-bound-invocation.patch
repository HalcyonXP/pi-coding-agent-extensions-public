diff --git a/packages/coding-agent/test/suite/tool-invocation.test.ts b/packages/coding-agent/test/suite/tool-invocation.test.ts
new file mode 100644
index 0000000..3d6bf94
--- /dev/null
+++ b/packages/coding-agent/test/suite/tool-invocation.test.ts
@@ -0,0 +1,420 @@
+// Native scoped invocation regression fixtures.
+import type { AgentToolInvocation, AgentToolResult, AgentToolScope } from "@earendil-works/pi-agent-core";
+import { fauxAssistantMessage, fauxToolCall } from "@earendil-works/pi-ai";
+import { registerFauxProvider } from "@earendil-works/pi-ai/compat";
+import { Type } from "typebox";
+import { afterEach, describe, expect, it } from "vitest";
+import type { ExtensionAPI, ExtensionContext } from "../../src/core/extensions/types.ts";
+import { createHarness, type Harness } from "./harness.ts";
+
+function text(value: string): AgentToolResult<unknown> {
+	return { content: [{ type: "text", text: value }], details: {} };
+}
+
+function tinyBmp(): string {
+	const buffer = Buffer.alloc(58);
+	buffer.write("BM", 0, "ascii");
+	buffer.writeUInt32LE(buffer.length, 2);
+	buffer.writeUInt32LE(54, 10);
+	buffer.writeUInt32LE(40, 14);
+	buffer.writeInt32LE(1, 18);
+	buffer.writeInt32LE(1, 22);
+	buffer.writeUInt16LE(1, 26);
+	buffer.writeUInt16LE(24, 28);
+	buffer.writeUInt32LE(4, 34);
+	buffer[56] = 0xff;
+	return buffer.toString("base64");
+}
+
+describe("AgentSession host-owned nested invocation", () => {
+	const harnesses: Harness[] = [];
+	afterEach(() => {
+		while (harnesses.length) harnesses.pop()?.cleanup();
+	});
+
+	async function fixture(body: (ctx: ExtensionContext) => Promise<void>, hooks?: (pi: ExtensionAPI) => void) {
+		let executed = 0;
+		const harness = await createHarness({
+			tools: [],
+			extensionFactories: [
+				(pi) => {
+					pi.registerTool({
+						name: "cell",
+						label: "Cell",
+						description: "Harmless host gateway fixture",
+						parameters: Type.Object({}),
+						execute: async (_id, _args, _signal, _update, ctx) => {
+							await body(ctx);
+							return text("cell complete");
+						},
+					});
+					pi.registerTool({
+						name: "target",
+						label: "Target",
+						description: "Harmless nested fixture",
+						parameters: Type.Object({ value: Type.Literal("allowed") }),
+						execute: async () => {
+							executed++;
+							return text("raw target result");
+						},
+					});
+					hooks?.(pi);
+				},
+			],
+		});
+		harnesses.push(harness);
+		harness.setResponses([
+			fauxAssistantMessage([fauxToolCall("cell", {})], { stopReason: "toolUse" }),
+			fauxAssistantMessage("done"),
+		]);
+		return {
+			harness,
+			executed: () => executed,
+			async run() {
+				await harness.session.prompt("offline gateway fixture");
+				expect(
+					harness.session.messages.find((message) => message.role === "toolResult" && message.toolName === "cell"),
+				).toMatchObject({ isError: false, content: [{ type: "text", text: "cell complete" }] });
+			},
+		};
+	}
+
+	it("runs real approval/result events and returns only filtered results", async () => {
+		const trace: string[] = [];
+		let result: unknown;
+		const f = await fixture(
+			async (ctx) => {
+				expect(ctx.tools?.parentToolCallId).toBeTruthy();
+				result = await ctx.tools?.invoke("target", { value: "allowed" });
+				trace.push("returned");
+			},
+			(pi) => {
+				pi.on("tool_call", (event, ctx) => {
+					expect(ctx.tools).toBeUndefined();
+					trace.push(`call:${event.toolName}`);
+				});
+				pi.on("tool_result", (event, ctx) => {
+					expect(ctx.tools).toBeUndefined();
+					trace.push(`result:${event.toolName}`);
+					if (event.toolName === "target") return { ...text("filtered by actual extension hook"), isError: true };
+				});
+			},
+		);
+		await f.run();
+		expect(f.executed()).toBe(1);
+		expect(result).toEqual({ result: text("filtered by actual extension hook"), isError: true });
+		expect(trace).toEqual(["call:cell", "call:target", "result:target", "returned", "result:cell"]);
+		expect(f.harness.eventsOfType("tool_execution_start").map((e) => e.toolName)).toEqual(["cell", "target"]);
+		expect(f.harness.session.messages.filter((m) => m.role === "toolResult")).toHaveLength(1);
+	});
+
+	it.each(["deny", "mutate", "invalid"])("prevents execution after actual %s handling", async (mode) => {
+		let result: { isError: boolean } | undefined;
+		const f = await fixture(
+			async (ctx) => {
+				result = await ctx.tools?.invoke("target", { value: mode === "invalid" ? "bad" : "allowed" });
+			},
+			(pi) => {
+				pi.on("tool_call", (event) => {
+					if (event.toolName === "target") {
+						if (mode === "deny") return { block: true, reason: "denied by actual extension" };
+						if (mode === "mutate") event.input.value = "bad";
+					}
+				});
+			},
+		);
+		await f.run();
+		expect(f.executed()).toBe(0);
+		expect(result?.isError).toBe(true);
+	});
+
+	it("normalizes images inserted by actual result hooks before returning to the parent", async () => {
+		let result: Awaited<ReturnType<AgentToolInvocation["invoke"]>> | undefined;
+		const f = await fixture(
+			async (ctx) => {
+				result = await ctx.tools?.invoke("target", { value: "allowed" });
+			},
+			(pi) => {
+				pi.on("tool_result", (event) => {
+					if (event.toolName === "target")
+						return { content: [{ type: "image", mimeType: "image/bmp", data: tinyBmp() }] };
+				});
+			},
+		);
+		await f.run();
+		expect(result?.result.content[0]).toMatchObject({ type: "image", mimeType: "image/png" });
+		expect(result?.result.content[1]).toMatchObject({
+			type: "text",
+			text: "[Image converted from image/bmp to image/png.]",
+		});
+	});
+
+	it("preserves live context getters instead of taking a model snapshot", async () => {
+		const f = await fixture(async (ctx) => {
+			const original = ctx.model;
+			expect(Object.getOwnPropertyDescriptor(ctx, "model")?.get).toBeTypeOf("function");
+			f.harness.session.agent.state.model = { ...f.harness.session.agent.state.model, id: "changed-for-fixture" };
+			expect(ctx.model?.id).toBe("changed-for-fixture");
+			if (original) f.harness.session.agent.state.model = original;
+			await expect(ctx.tools?.invoke("target", { value: "allowed" })).rejects.toThrow(/stale/);
+		});
+		await f.run();
+		expect(f.executed()).toBe(0);
+	});
+
+	it("revokes the parent if an approval hook changes the active registry", async () => {
+		const f = await fixture(
+			async (ctx) => {
+				await expect(ctx.tools?.invoke("target", { value: "allowed" })).rejects.toThrow(/stale/);
+			},
+			(pi) => {
+				pi.on("tool_call", (event) => {
+					if (event.toolName === "target") pi.setActiveTools(["cell"]);
+				});
+			},
+		);
+		await f.run();
+		expect(f.executed()).toBe(0);
+	});
+
+	it("withholds a target result revoked by its real result hook", async () => {
+		const f = await fixture(
+			async (ctx) => {
+				await expect(ctx.tools?.invoke("target", { value: "allowed" })).rejects.toThrow(/stale/);
+			},
+			(pi) => {
+				pi.on("tool_result", (event) => {
+					if (event.toolName === "target") pi.setActiveTools(["cell"]);
+				});
+			},
+		);
+		await f.run();
+		expect(f.executed()).toBe(1);
+		expect(JSON.stringify(f.harness.eventsOfType("tool_execution_end"))).not.toContain("raw target result");
+	});
+
+	it("revokes pending approval at reload entry, before asynchronous shutdown completes", async () => {
+		let approvalStarted = () => {};
+		const started = new Promise<void>((resolve) => {
+			approvalStarted = resolve;
+		});
+		let releaseApproval = () => {};
+		const approval = new Promise<void>((resolve) => {
+			releaseApproval = resolve;
+		});
+		let releaseShutdown = () => {};
+		const shutdown = new Promise<void>((resolve) => {
+			releaseShutdown = resolve;
+		});
+		let scope: AgentToolInvocation | undefined;
+		let oldContext: ExtensionContext | undefined;
+		let rejected = false;
+		const f = await fixture(
+			async (ctx) => {
+				scope = ctx.tools;
+				oldContext = ctx;
+				try {
+					await scope?.invoke("target", { value: "allowed" });
+				} catch {
+					rejected = true;
+				}
+			},
+			(pi) => {
+				pi.on("tool_call", async (event) => {
+					if (event.toolName === "target") {
+						approvalStarted();
+						await approval;
+					}
+				});
+				pi.on("session_shutdown", async () => {
+					await shutdown;
+				});
+			},
+		);
+		const prompt = f.harness.session.prompt("offline reload race");
+		await started;
+		const reload = f.harness.session.reload();
+		expect(scope?.signal.aborted).toBe(true);
+		await expect(scope?.invoke("target", { value: "allowed" })).rejects.toThrow(/stale/);
+		releaseApproval();
+		releaseShutdown();
+		await Promise.allSettled([reload, prompt]);
+		expect(rejected).toBe(true);
+		expect(f.executed()).toBe(0);
+		expect(() => oldContext?.model).toThrow(/stale/);
+	});
+
+	it("does not grant an invocation to a direct stale wrapper call", async () => {
+		let scoped = false;
+		const f = await fixture(async (ctx) => {
+			scoped = ctx.tools !== undefined;
+		});
+		const tool = f.harness.session.agent.state.tools.find((t) => t.name === "cell");
+		await tool?.execute("not-a-host-parent", {});
+		expect(scoped).toBe(false);
+	});
+
+	it("adopts a genuine durable scope in a later AgentSession handler and preserves real finalized normalization", async () => {
+		let cell!: AgentToolScope,
+			old!: AgentToolInvocation,
+			turn = 0,
+			received: unknown;
+		const trace: string[] = [];
+		const f = await fixture(
+			async (ctx) => {
+				if (turn++ === 0) {
+					old = ctx.tools!;
+					cell = old.openScope();
+					return;
+				}
+				expect(ctx.tools).not.toBe(old);
+				const adopted = ctx.tools!.adoptScope(cell);
+				received = await adopted.invoke("target", { value: "allowed" });
+			},
+			(pi) => {
+				pi.on("tool_call", (event) => {
+					if (event.toolName === "target") trace.push("approval");
+				});
+				pi.on("tool_result", (event) => {
+					if (event.toolName === "target") {
+						trace.push("result");
+						return { content: [{ type: "image", data: tinyBmp(), mimeType: "image/bmp" }] };
+					}
+					return undefined;
+				});
+			},
+		);
+		try {
+			await f.run();
+			expect(cell.state).toBe("active");
+			await expect(old.invoke("target", { value: "allowed" })).rejects.toThrow(/expired/);
+			f.harness.setResponses([
+				fauxAssistantMessage([fauxToolCall("cell", {})], { stopReason: "toolUse" }),
+				fauxAssistantMessage("later done"),
+			]);
+			await f.harness.session.prompt("later actual session handler");
+			expect(received).toMatchObject({
+				isError: false,
+				result: {
+					content: [
+						{ type: "image", mimeType: "image/png" },
+						{ type: "text", text: "[Image converted from image/bmp to image/png.]" },
+					],
+				},
+			});
+			expect(trace).toEqual(["approval", "result"]);
+			expect(f.executed()).toBe(1);
+			expect(f.harness.session.messages.filter((message) => message.role === "toolResult")).toHaveLength(2);
+		} finally {
+			await cell?.close();
+		}
+	});
+
+	it("delivers actual idle-session approval/result hooks without an expired run event sink", async () => {
+		let cell!: AgentToolScope;
+		const trace: string[] = [];
+		const f = await fixture(
+			async (ctx) => {
+				cell = ctx.tools!.openScope();
+			},
+			(pi) => {
+				pi.on("tool_call", (event) => {
+					if (event.toolName === "target") trace.push("approval");
+				});
+				pi.on("tool_result", (event) => (event.toolName === "target" ? text("idle finalized") : undefined));
+			},
+		);
+		try {
+			await f.run();
+			expect(f.harness.session.agent.state.isStreaming).toBe(false);
+			const result = await cell.invoke("target", { value: "allowed" });
+			expect(result.result.content).toEqual([{ type: "text", text: "idle finalized" }]);
+			expect(trace).toEqual(["approval"]);
+			const ends = f.harness.eventsOfType("tool_execution_end").filter((event) => event.toolName === "target");
+			expect(ends).toHaveLength(1);
+			expect(ends[0].scopeId).toBe(cell.id);
+		} finally {
+			await cell?.close();
+		}
+	});
+
+	it("revokes durable calls after actual active-tool replacement", async () => {
+		let cell!: AgentToolScope, api!: ExtensionAPI;
+		const f = await fixture(
+			async (ctx) => {
+				cell = ctx.tools!.openScope();
+			},
+			(pi) => {
+				api = pi;
+			},
+		);
+		await f.run();
+		api.setActiveTools(["cell"]);
+		await expect(cell.invoke("target", { value: "allowed" })).rejects.toThrow(/expired/);
+		await cell.close();
+		expect(f.executed()).toBe(0);
+	});
+
+	it("retains Agent-owned admission across an actual extension reload until resource cleanup completes", async () => {
+		let cell!: AgentToolScope,
+			turn = 0,
+			release = () => {};
+		let restored: ReturnType<typeof registerFauxProvider> | undefined;
+		const gate = new Promise<void>((resolve) => {
+			release = resolve;
+		});
+		const f = await fixture(async (ctx) => {
+			if (turn++ === 0) {
+				cell = ctx.tools!.openScope();
+				cell.ownResource(() => gate);
+			} else expect(() => ctx.tools!.openScope()).toThrow(/cleanup/);
+		});
+		try {
+			await f.run();
+			await f.harness.session.reload();
+			expect(cell.state).toBe("draining");
+			// Real reload resets compatibility providers. Re-register only the offline model fixture.
+			restored = registerFauxProvider({
+				api: f.harness.faux.api,
+				provider: f.harness.getModel().provider,
+				models: f.harness.models,
+			});
+			restored.setResponses([
+				fauxAssistantMessage([fauxToolCall("cell", {})], { stopReason: "toolUse" }),
+				fauxAssistantMessage("reload done"),
+			]);
+			await f.harness.session.prompt("after actual reload");
+			expect(
+				turn,
+				JSON.stringify(
+					f.harness.session.messages
+						.filter((message) => message.role === "assistant")
+						.map((message) => message.errorMessage),
+				),
+			).toBe(2);
+			expect(cell.signal.aborted).toBe(true);
+		} finally {
+			release();
+			await cell?.close();
+			restored?.unregister();
+		}
+	});
+
+	it("does not adopt another actual AgentSession's native scope", async () => {
+		let cell!: AgentToolScope;
+		const owner = await fixture(async (ctx) => {
+			cell = ctx.tools!.openScope();
+		});
+		await owner.run();
+		try {
+			const other = await fixture(async (ctx) => {
+				expect(() => ctx.tools!.adoptScope(cell)).toThrow(/foreign/);
+				expect(() => ctx.tools!.adoptScope({ ...cell })).toThrow(/foreign/);
+			});
+			await other.run();
+			expect(cell.state).toBe("active");
+		} finally {
+			await cell?.close();
+		}
+	});
+});
