+
+function text(value: string): AgentToolResult<unknown> {
+	return { content: [{ type: "text", text: value }], details: {} };
+}
+
+function deferred() {
+	let resolve = () => {};
+	const promise = new Promise<void>((done) => {
+		resolve = done;
+	});
+	return { promise, resolve };
+}
+
+function fixture(body: (scope: AgentToolInvocation) => Promise<void>, childExecute?: AgentTool["execute"]) {
+	let executed = 0;
+	const events: AgentEvent[] = [];
+	const child: AgentTool = {
+		name: "child",
+		label: "Child",
+		description: "Harmless fixture",
+		parameters: Type.Object({ value: Type.Literal("allowed") }),
+		execute:
+			childExecute ??
+			(async () => {
+				executed++;
+				return text("raw");
+			}),
+	};
+	const parent: AgentTool = {
+		name: "parent",
+		label: "Parent",
+		description: "Host capability receiver",
+		parameters: Type.Object({}),
+		execute: async () => {
+			throw new Error("Missing host invocation");
+		},
+		withInvocation: (scope) => ({
+			...parent,
+			execute: async () => {
+				await body(scope);
+				return text("parent completed");
+			},
+		}),
+	};
+	let calls = 0;
+	let generation = 0;
+	const agent = new Agent({
+		initialState: { tools: [parent, child] },
+		streamFn: () => {
+			const stream = new EventStream<AssistantMessageEvent, AssistantMessage>(
+				(event) => event.type === "done" || event.type === "error",
+				(event) => {
+					if (event.type === "done") return event.message;
+					throw new Error("Unexpected stream failure");
+				},
+			);
+			const first = calls++ === 0;
+			const message: AssistantMessage = {
+				role: "assistant",
+				content: first
