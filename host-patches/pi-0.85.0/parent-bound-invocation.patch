+	timer?: ReturnType<typeof setTimeout>;
+	revoke: () => void;
+	api?: AgentToolScope;
+	onResult?: AgentToolScopeOptions["onResult"];
+	resolveImageReference?: AgentToolScopeOptions["resolveImageReference"];
+	publicationCalls: number;
+	publicationPending: number;
+};
+
+/** Native Agent-owned admission, not extension/module-owned quota or caller-ID authority.
+ * A shorter test lifetime is allowed; a caller cannot expand the six-minute ceiling.
+ */
+export class ToolScopeRegistry {
+	private readonly records = new Map<AgentToolScope, RecordState>();
+	private readonly resourceScopes = new WeakMap<AgentToolResourceScope, RecordState>();
+	private readonly lifetimeMs: number;
+	constructor(lifetimeMs = 360_000) {
+		this.lifetimeMs = lifetimeMs;
+		if (!Number.isSafeInteger(lifetimeMs) || lifetimeMs < 1 || lifetimeMs > 360_000)
+			throw new Error("Invalid host scope lifetime");
+	}
+	get size(): number {
+		return this.records.size;
+	}
+
+	private expire(record: RecordState): void {
+		if (record.state === "active" && (record.epoch?.aborted || performance.now() >= record.deadline)) record.revoke();
+	}
+
+	open(
+		epoch: AbortSignal,
+		create: (scope: AgentToolResourceScope) => Backend,
+		options?: AgentToolScopeOptions,
+	): AgentToolScope {
+		for (const record of this.records.values()) this.expire(record);
+		if (
+			epoch.aborted ||
+			this.records.size >= 2 ||
+			[...this.records.values()].some((record) => record.state !== "active")
+		) {
+			throw new Error("Durable scope admission unavailable or prior cleanup incomplete");
+		}
+		const record: RecordState = {
+			id: uuidv7(),
+			deadline: performance.now() + this.lifetimeMs,
+			epoch,
+			controller: new AbortController(),
+			resources: new Set(),
+			backendClosed: false,
+			cleanupPending: 0,
+			state: "active",
+			onResult: options?.onResult,
+			resolveImageReference: options?.resolveImageReference,
+			publicationCalls: 0,
+			publicationPending: 0,
+			revoke: () => {},
+		};
+		const expire = () => this.expire(record);
+		const assertCurrent = () => {
+			expire();
+			if (
+				record.state !== "active" ||
+				record.controller.signal.aborted ||
+				record.epoch?.aborted ||
+				performance.now() >= record.deadline
+			)
+				throw new Error("Durable tool scope is expired or revoked");
+		};
+		const finish = () => {
+			if (record.state !== "draining" || !record.backendClosed || record.cleanupPending || record.resources.size)
+				return;
+			record.state = "closed";
+			record.epoch?.removeEventListener("abort", record.revoke);
+			record.epoch = undefined;
+			record.onResult = undefined;
+			record.resolveImageReference = undefined;
+			this.resourceScopes.delete(resourceScope);
+			if (record.api) this.records.delete(record.api);
+		};
+		const ownResource = (close: () => Promise<void>) => {
+			assertCurrent();
+			if (typeof close !== "function" || record.resources.size >= 16)
+				throw new Error("Invalid or excessive scope resources");
+			const resource: Resource = { close };
+			record.resources.add(resource);
+			// Only a native tool receives this release closure, never generated JavaScript.
+			return () => {
+				record.resources.delete(resource);
+				finish();
+			};
+		};
+		const resourceScope: AgentToolResourceScope = Object.freeze({
+			id: record.id,
+			get signal() {
+				expire();
+				return record.controller.signal;
+			},
+			ownResource,
+		});
+		this.resourceScopes.set(resourceScope, record);
+		const close = (): Promise<void> => {
+			if (record.state === "closed") return Promise.resolve();
+			if (record.closing) return record.closing;
+			let resolve!: () => void;
+			let reject!: (error: unknown) => void;
+			record.closing = new Promise<void>((done, fail) => {
+				resolve = done;
+				reject = fail;
+			});
+			record.state = "draining";
+			clearTimeout(record.timer);
+			record.controller.abort();
+			void (async () => {
+				const drain = Promise.resolve()
+					.then(() => record.backend?.close())
+					.then(() => {
+						record.backendClosed = true;
+						record.backend = undefined;
+					});
+				const resources = [...record.resources].map((resource) => {
+					record.cleanupPending++;
+					return Promise.resolve()
+						.then(() => resource.close())
+						.then(() => {
+							record.resources.delete(resource);
+						})
+						.finally(() => {
+							record.cleanupPending--;
+							finish();
+						});
+				});
+				await Promise.allSettled([drain, ...resources]);
+				finish();
+				if (record.state !== "closed") throw new Error("Durable scope cleanup could not be confirmed");
+			})().then(resolve, reject);
+			return record.closing;
+		};
+		const api: AgentToolScope = Object.freeze({
+			...resourceScope,
+			get signal() {
+				expire();
+				return record.controller.signal;
+			},
+			get state() {
+				expire();
+				return record.state;
+			},
+			invoke: (...args: Parameters<AgentToolInvocation["invoke"]>) => {
+				try {
+					assertCurrent();
+					return record.backend!.invoke(...args).then((outcome) => {
+						assertCurrent();
+						if (outcome.result.terminate) void close().catch(() => {});
+						return outcome;
+					});
+				} catch {
+					return Promise.reject(new Error("Durable tool scope is expired or unavailable"));
+				}
+			},
+			close,
+			async publishEvidence(evidence: AgentToolEvidence) {
+				assertCurrent();
+				if (!record.onResult || !record.backend?.publishEvidence)
+					throw new Error("Protected presentation is unavailable");
+				if (record.publicationCalls >= 64 || record.publicationPending >= 4)
+					throw new Error("Protected publication budget exceeded");
+				let task: Promise<void>;
+				const release = ownResource(async () => {
+					await task;
+				});
+				record.publicationCalls++;
+				record.publicationPending++;
+				task = Promise.resolve().then(() => {
+					assertCurrent();
+					return record.backend!.publishEvidence!(structuredClone(evidence));
+				});
+				let confirmed = false;
+				try {
+					await task;
+					confirmed = true;
+					assertCurrent();
+				} catch {
+					throw new Error("Protected presentation failed");
+				} finally {
+					record.publicationPending--;
+					// A rejected publisher has no successful receipt. Keep its failed
+					// cleanup resource even for an explicit image(ref) helper call.
+					if (confirmed) release();
+				}
+			},
+		});
+		record.api = api;
+		this.records.set(api, record);
+		try {
+			record.backend = create(resourceScope);
+		} catch {
+			record.backendClosed = true;
+			void close().catch(() => {});
+			throw new Error("Durable scope initialization failed");
+		}
+		record.revoke = () => {
+			void close().catch(() => {});
+		};
+		epoch.addEventListener("abort", record.revoke, { once: true });
+		record.timer = setTimeout(record.revoke, Math.max(0, record.deadline - performance.now()));
+		record.timer.unref?.();
+		this.expire(record);
+		return api;
+	}
+
+	hasProtectedResults(scope: AgentToolResourceScope): boolean {
+		this.assertActiveResource(scope);
+		const record = this.resourceScopes.get(scope)!;
+		return Boolean(record.onResult && record.backend?.publishEvidence);
+	}
+	resolveImageReference(scope: AgentToolResourceScope, ref: string) {
+		this.assertActiveResource(scope);
+		const record = this.resourceScopes.get(scope)!;
+		if (
+			!record.onResult ||
+			!record.resolveImageReference ||
+			typeof ref !== "string" ||
+			!/^img_[a-f0-9-]{36}$/.test(ref)
+		)
+			throw new Error("Unknown or unavailable protected image reference");
+		try {
+			const image = structuredClone(record.resolveImageReference(ref));
+			this.assertActiveResource(scope);
+			return image;
+		} catch {
+			throw new Error("Unknown or unavailable protected image reference");
+		}
+	}
+	async publishFinalized(scope: AgentToolResourceScope, event: AgentScopedResult): Promise<void> {
+		this.assertActiveResource(scope);
+		const record = this.resourceScopes.get(scope)!;
+		if (!record.onResult) return;
+		if (!record.backend?.publishEvidence || event.scopeId !== scope.id)
+			throw new Error("Protected result owner is unavailable");
+		try {
+			await record.onResult(structuredClone(event));
+		} catch {
+			throw new Error("Protected result publication failed");
+		}
+		this.assertActiveResource(scope);
+	}
+	assertActiveResource(scope: AgentToolResourceScope): void {
+		const record = this.resourceScopes.get(scope);
+		if (record) this.expire(record);
+		if (
+			!record ||
+			record.state !== "active" ||
+			record.controller.signal.aborted ||
+			performance.now() >= record.deadline
+		)
+			throw new Error("Durable tool scope is expired or revoked");
+	}
+
+	/** Native event-sink ownership, including cancellation events during drain. */
+	eventSignal(scope: AgentToolResourceScope): AbortSignal {
+		const record = this.resourceScopes.get(scope);
+		if (!record || record.state === "closed") throw new Error("Unknown or closed scope event owner");
+		return record.controller.signal;
+	}
+
+	adopt(scope: AgentToolScope, epoch: AbortSignal): AgentToolScope {
+		const record = this.records.get(scope);
+		if (record) this.expire(record);
+		if (!record || record.epoch !== epoch || epoch.aborted || record.state !== "active")
+			throw new Error("Unknown, foreign or stale durable tool scope");
+		return scope;
+	}
+}
