+			const registry = new ToolScopeRegistry(),
+				epoch = new AbortController();
+			let view!: AgentToolResourceScope;
+			const scope = registry.open(epoch.signal, (resource) => {
+				view = resource;
+				return backend();
+			});
+			try {
+				clock.mockReturnValue(performance.now() + 360_001);
+				if (boundary === "invoke") await expect(scope.invoke("child", {})).rejects.toThrow(/expired/);
+				if (boundary === "adopt") expect(() => registry.adopt(scope, epoch.signal)).toThrow(/stale/);
+				if (boundary === "resource") expect(() => scope.ownResource(async () => {})).toThrow(/expired/);
+				if (boundary === "host-guard") expect(() => registry.assertActiveResource(view)).toThrow(/expired/);
+				if (boundary === "signal") expect(scope.signal.aborted).toBe(true);
+				if (boundary === "admission") expect(() => registry.open(epoch.signal, backend)).toThrow(/cleanup/);
+				await scope.close();
+				expect(registry.size).toBe(0);
+			} finally {
+				clock.mockRestore();
+				await scope.close();
+			}
+		}
+	});
