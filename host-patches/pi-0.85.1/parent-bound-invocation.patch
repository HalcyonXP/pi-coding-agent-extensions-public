new file mode 100644
index 0000000..bb94544
--- /dev/null
+++ b/packages/agent/src/tool-context.ts
@@ -0,0 +1,124 @@
+import type { AgentMessage, AgentToolTextContext, AgentToolTextContextCapture } from "./types.ts";
+
+/** Bounded literal context, never raw session ancestry. Matching serialized Responses
+ * request text is a consistency check, not authority: only a native invocation
+ * can read this view. Native transport/cache handling still owns dispatch.
+ */
+export class ToolContextSnapshot {
+	private current?: {
+		signal: AbortSignal;
+		context: AgentToolTextContext;
+		approved: boolean;
+		finished: boolean;
+		ready: boolean;
+	};
+
+	begin(messages: AgentMessage[], signal: AbortSignal, api: string): AgentToolTextContextCapture | undefined {
+		this.current = undefined;
+		if (signal.aborted || !["openai-responses", "openai-codex-responses"].includes(api)) return;
+		try {
+			const lower = Math.max(0, messages.length - 512);
+			let first = -1,
+				last = -1;
+			for (let i = messages.length - 1; i >= lower; i--) {
+				if (messages[i].role !== "user") continue;
+				if (last < 0) first = last = i;
+				else {
+					first = i;
+					break;
+				}
+			}
+			if (lower > 0 && first === last) return;
+			let bytes = 0,
+				blockCount = 0;
+			const context: Array<AgentToolTextContext[number]> = [];
+			for (let i = first; i >= 0 && i <= last; i++) {
+				const m = messages[i];
+				if (m.role !== "user" && m.role !== "assistant") continue;
+				const blocks = typeof m.content === "string" ? [{ type: "text", text: m.content }] : m.content;
+				if (!Array.isArray(blocks)) return;
+				blockCount += blocks.length;
+				if (blockCount > 128) return;
+				const content: Array<{ readonly type: "text"; readonly text: string }> = [];
+				for (const block of blocks) {
+					if (block.type !== "text") continue;
+					if (typeof block.text !== "string" || block.text.length > 65536) return;
+					bytes += new TextEncoder().encode(block.text).byteLength;
+					if (bytes > 65536) return;
+					content.push(Object.freeze({ type: "text", text: block.text }));
+				}
+				context.push(Object.freeze({ role: m.role, content: Object.freeze(content) }));
+			}
+			const record = { signal, context: Object.freeze(context), approved: false, finished: false, ready: false };
+			this.current = record;
+			return {
+				confirm: (body) => {
+					if (this.current !== record || signal.aborted || record.finished) return;
+					record.approved = false;
+					try {
+						// Inspect bytes the native provider serialized once, never a payload
+						// object whose getters/toJSON could disclose different wire text.
+						if (
+							typeof body !== "string" ||
+							body.length > 2 * 1024 * 1024 ||
+							new TextEncoder().encode(body).byteLength > 2 * 1024 * 1024
+						)
+							return;
+						record.approved = matchesPayload(record.context, JSON.parse(body));
+					} catch {
+						/* unavailable, never a raw-history fallback */
+					}
+				},
+				complete: (success) => {
+					if (this.current !== record || signal.aborted || record.finished) return;
+					record.finished = true;
+					record.ready = success && record.approved;
+				},
+			};
+		} catch {
+			return;
+		}
+	}
+
+	clear(): void {
+		this.current = undefined;
+	}
+
+	read(signal: AbortSignal): AgentToolTextContext | undefined {
+		const record = this.current;
+		return record?.signal === signal && !signal.aborted && record.ready ? record.context : undefined;
+	}
+}
+
+function matchesPayload(context: AgentToolTextContext, value: unknown): boolean {
+	if (!value || typeof value !== "object") return false;
+	const input = (value as { input?: unknown }).input;
+	if (!Array.isArray(input) || input.length > 4096) return false;
+	const expected = context.flatMap((m) =>
+		m.role === "assistant"
+			? m.content.map((b) => ({ role: m.role, text: [b.text] }))
+			: [{ role: m.role, text: m.content.map((b) => b.text) }],
+	);
+	let cursor = 0;
+	for (const item of input) {
+		if (cursor === expected.length) break;
+		if (
+			!item ||
+			typeof item !== "object" ||
+			(item.type !== undefined && item.type !== "message") ||
+			item.role !== expected[cursor].role
+		)
+			continue;
+		const blocks = typeof item.content === "string" ? [{ type: "input_text", text: item.content }] : item.content;
+		if (!Array.isArray(blocks) || blocks.length > 128) return false;
+		const text: string[] = [];
+		for (const b of blocks) {
+			if (!b || typeof b !== "object" || !["input_text", "output_text"].includes(b.type)) continue;
+			if (typeof b.text !== "string") return false;
+			text.push(b.text);
+		}
+		if (text.length === expected[cursor].text.length && text.every((t, i) => t === expected[cursor].text[i]))
+			cursor++;
+	}
+	return cursor === expected.length;
+}
