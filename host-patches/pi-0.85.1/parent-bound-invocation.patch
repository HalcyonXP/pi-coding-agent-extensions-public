+				if (record.publicationCalls >= 64 || record.publicationPending >= 4)
+					throw new Error("Protected publication budget exceeded");
+				let task: Promise<boolean>;
+				let dispatched = false;
+				const release = ownResource(async () => {
+					try {
+						await task;
+					} catch (error) {
+						if (dispatched) throw error;
+					}
+				});
+				record.publicationCalls++;
+				record.publicationPending++;
+				task = Promise.resolve().then(async () => {
+					assertCurrent();
+					dispatched = true;
+					const accepted = await record.backend!.notify!(text);
+					if (typeof accepted !== "boolean") throw new Error("Unconfirmed notification acceptance");
+					return accepted;
+				});
+				let confirmed = false;
+				try {
+					const accepted = await task;
+					confirmed = true;
+					assertCurrent();
+					return accepted;
+				} catch {
+					throw new Error("Protected notification failed");
+				} finally {
+					record.publicationPending--;
+					// Definite pre-dispatch cancellation and idle refusal release safely.
+					// A dispatched publisher with a thrown/invalid receipt remains unconfirmed.
+					if (confirmed || !dispatched) release();
+				}
+			},
+			async publishEvidence(evidence: AgentToolEvidence) {
+				assertCurrent();
+				if (!record.onResult || !record.backend?.publishEvidence)
+					throw new Error("Protected presentation is unavailable");
+				if (record.publicationCalls >= 64 || record.publicationPending >= 4)
+					throw new Error("Protected publication budget exceeded");
+				let task: Promise<void>;
+				const release = ownResource(async () => {
+					await task;
+				});
+				record.publicationCalls++;
+				record.publicationPending++;
