@@ -0,0 +1,186 @@
+import { describe, expect, it } from "vitest";
+import { ToolScopeRegistry } from "../src/tool-scopes.ts";
+
+const base = { invoke: async () => ({ result: { content: [], details: {} }, isError: false }), close: async () => {} };
+const protectedOptions = { onResult: async () => {} };
+
+describe("native notification publication ownership", () => {
+	it("requires a protected scope and a real backend", async () => {
+		for (const protection of [false, true]) {
+			const registry = new ToolScopeRegistry();
+			const scope = registry.open(
+				new AbortController().signal,
+				() => base,
+				protection ? protectedOptions : undefined,
+			);
+			expect(scope.canNotify!()).toBe(false);
+			await expect(scope.notify!("test")).rejects.toThrow(/unavailable/);
+			await scope.close();
+			expect(registry.size).toBe(0);
+		}
+	});
+	it("returns queue acceptance or confirmed idle refusal without leaking cleanup", async () => {
+		for (const accepted of [true, false]) {
+			const registry = new ToolScopeRegistry();
+			const seen: string[] = [];
+			const scope = registry.open(
+				new AbortController().signal,
+				() => ({
+					...base,
+					notify: async (text) => {
+						seen.push(text);
+						return accepted;
+					},
+				}),
+				protectedOptions,
+			);
+			expect(scope.canNotify!()).toBe(true);
+			expect(await scope.notify!("literal 😀\ntext")).toBe(accepted);
+			expect(seen).toEqual(["literal 😀\ntext"]);
+			await scope.close();
+			expect(registry.size).toBe(0);
+			await expect(scope.notify!("late")).rejects.toThrow(/revoked/);
+		}
+	});
+	it("refuses nonprimitive/oversized values before a backend effect", async () => {
+		const registry = new ToolScopeRegistry();
+		let effects = 0;
+		const scope = registry.open(
+			new AbortController().signal,
+			() => ({
+				...base,
+				notify: async () => {
+					effects++;
+					return true;
+				},
+			}),
+			protectedOptions,
+		);
+		for (const value of [null, undefined, {}, new String("wrapped"), "x".repeat(65537), "😀".repeat(16385)])
+			await expect(scope.notify!(value as string)).rejects.toThrow(/notification text/);
+		expect(effects).toBe(0);
+		await scope.close();
+	});
+	it("shares the existing 64-publication ceiling with evidence", async () => {
+		const registry = new ToolScopeRegistry();
+		let effects = 0;
+		const scope = registry.open(
+			new AbortController().signal,
+			() => ({
+				...base,
+				notify: async () => {
+					effects++;
+					return true;
+				},
+				publishEvidence: async () => {
+					effects++;
+				},
+			}),
+			protectedOptions,
+		);
+		for (let i = 0; i < 32; i++) {
+			await scope.notify!("n");
+			await scope.publishEvidence({ content: [] });
+		}
+		await expect(scope.notify!("overflow")).rejects.toThrow(/budget/);
+		await expect(scope.publishEvidence({ content: [] })).rejects.toThrow(/budget/);
+		expect(effects).toBe(64);
+		await scope.close();
+	});
+	it("shares the four-pending-publication ceiling and waits for confirmed drain", async () => {
+		const registry = new ToolScopeRegistry();
+		let finish!: () => void;
+		const gate = new Promise<void>((resolve) => {
+			finish = resolve;
+		});
+		const scope = registry.open(
+			new AbortController().signal,
+			() => ({
+				...base,
+				notify: async () => {
+					await gate;
+					return true;
+				},
+				publishEvidence: async () => {
+					await gate;
+				},
+			}),
+			protectedOptions,
+		);
+		const pending = [
+			scope.notify!("1"),
+			scope.publishEvidence({ content: [] }),
+			scope.notify!("2"),
+			scope.notify!("3"),
+		];
+		await expect(scope.notify!("overflow")).rejects.toThrow(/budget/);
+		const outcomes = Promise.allSettled(pending);
+		const closing = scope.close();
+		expect(registry.status).toEqual({ active: 0, draining: 1 });
+		finish();
+		await outcomes;
+		await closing;
+		expect(registry.size).toBe(0);
+	});
+	for (const failure of ["throw", "invalid"])
+		it(`keeps unconfirmed ${failure} publication draining without replay`, async () => {
+			const registry = new ToolScopeRegistry();
+			let effects = 0;
+			const scope = registry.open(
+				new AbortController().signal,
+				() => ({
+					...base,
+					notify: async () => {
+						effects++;
+						if (failure === "throw") throw Error("failed after possible publication");
+						return undefined as unknown as boolean;
+					},
+				}),
+				protectedOptions,
+			);
+			await expect(scope.notify!("uncertain")).rejects.toThrow(/failed/);
+			await expect(scope.close()).rejects.toThrow();
+			expect(registry.status).toEqual({ active: 0, draining: 1 });
+			expect(() => registry.open(new AbortController().signal, () => base)).toThrow(/cleanup/);
+			expect(effects).toBe(1);
+		});
+});
+
+it("notification cancellation before backend dispatch has confirmed zero effects", async () => {
+	const registry = new ToolScopeRegistry();
+	let effects = 0;
+	const scope = registry.open(
+		new AbortController().signal,
+		() => ({
+			...base,
+			notify: async () => {
+				effects++;
+				return true;
+			},
+		}),
+		protectedOptions,
+	);
+	const pending = scope.notify!("not dispatched");
+	const rejected = expect(pending).rejects.toThrow(/failed/);
+	const closed = scope.close();
+	await rejected;
+	await closed;
+	expect(effects).toBe(0);
+	expect(registry.size).toBe(0);
+});
+
+it("notification backend alone cannot authorize an unprotected scope", async () => {
+	const registry = new ToolScopeRegistry();
+	let effects = 0;
+	const scope = registry.open(new AbortController().signal, () => ({
+		...base,
+		notify: async () => {
+			effects++;
+			return true;
+		},
+	}));
+	expect(scope.canNotify!()).toBe(false);
+	await expect(scope.notify!("unprotected")).rejects.toThrow(/unavailable/);
+	expect(effects).toBe(0);
+	await scope.close();
+});
