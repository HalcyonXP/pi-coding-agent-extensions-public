@@ -0,0 +1,315 @@
+import { Container, MouseRegion, stripTerminalSequences, Text, truncateToWidth } from "@earendil-works/pi-tui";
+import type { AgentSessionEvent } from "../../../core/agent-session.ts";
+import type { CustomMessage } from "../../../core/messages.ts";
+import { theme } from "../theme/theme.ts";
+import type { CustomMessageComponent } from "./custom-message.ts";
+import { keyHint } from "./keybinding-hints.ts";
+import type { ToolExecutionComponent } from "./tool-execution.ts";
+
+type Start = Extract<AgentSessionEvent, { type: "tool_execution_start" }>;
+type Result = Parameters<ToolExecutionComponent["updateResult"]>[0];
+type Job = { number: number; status: string; preview: string; session?: string | number };
+type Call = { start: Start; args: string; component: ToolExecutionComponent; job: Job; prominent: boolean };
+
+// These bounds concern presentation only. No scope/resource authority or result persistence is added.
+const MAX_RECORDS = 64;
+const MAX_ROWS = 8;
+function data(value: unknown): Record<string, unknown> | undefined {
+	if (!value || typeof value !== "object" || Array.isArray(value)) return;
+	const prototype = Object.getPrototypeOf(value);
+	if (prototype !== Object.prototype && prototype !== null) return;
+	const copy: Record<string, unknown> = Object.create(null);
+	for (const key of Reflect.ownKeys(value)) {
+		if (typeof key !== "string") return;
+		const d = Object.getOwnPropertyDescriptor(value, key);
+		if (!d || !("value" in d)) return;
+		copy[key] = d.value;
+	}
+	return copy;
+}
+const id = (value: unknown): value is string => typeof value === "string" && value.length > 0 && value.length <= 1024;
+// Session lookup equality remains typed: numeric 7 must never adopt string "7".
+const sessionId = (value: unknown): value is string | number =>
+	id(value) || (typeof value === "number" && Number.isInteger(value) && value > 0 && value <= 2147483647);
+function stdin(args: unknown): Record<string, unknown> | undefined {
+	const value = data(args);
+	if (
+		value &&
+		sessionId(value.session_id) &&
+		(!Object.hasOwn(value, "chars") || value.chars === "") &&
+		Object.keys(value).every((key) => ["session_id", "chars", "yield_time_ms", "max_output_tokens"].includes(key))
+	)
+		return value;
+}
+function argumentsFor(event: Start): Record<string, unknown> | undefined {
+	const args = event.toolName === "write_stdin" ? stdin(event.args) : data(event.args);
+	if (!args || Object.values(args).some((v) => v !== undefined && !["string", "number", "boolean"].includes(typeof v)))
+		return;
+	if (event.toolName === "write_stdin") return args;
+	if (
+		event.toolName === "exec_command" &&
+		typeof args.cmd === "string" &&
+		args.cmd.length > 0 &&
+		args.cmd.length <= 65536 &&
+		Object.keys(args).every((key) => ["cmd", "workdir", "yield_time_ms", "max_output_tokens", "tty"].includes(key))
+	)
+		return args;
+}
+export function localJobStart(event: Start): boolean {
+	try {
+		return id(event.scopeId) && id(event.toolCallId) && !!argumentsFor(event);
+	} catch {
+		return false;
+	}
+}
+
+// Only ordinary successful shell shapes get a short preview. Everything else keeps its native card.
+export function localJobResult(
+	result: unknown,
+): { output: string; running: boolean; session?: string | number } | undefined {
+	try {
+		const value = data(result);
+		if (!value || value.isError !== false) return;
+		for (const key of ["usage", "terminate"]) if (value[key] === undefined) delete value[key];
+		if (Object.keys(value).some((key) => !["content", "details", "isError"].includes(key))) return;
+		const detail = data(value.details);
+		if (!detail) return;
+		// Unified exec retains these own JS properties when absent; JSON omits them.
+		for (const key of ["termination", "session_id"]) if (detail[key] === undefined) delete detail[key];
+		if (
+			Object.keys(detail).some(
+				(key) =>
+					!["session_id", "output", "exit_code", "running", "supervisor_ready", "truncated_bytes"].includes(key),
+			) ||
+			typeof detail.output !== "string" ||
+			detail.output.length > 65536 ||
+			detail.truncated_bytes !== 0 ||
+			(Object.hasOwn(detail, "supervisor_ready") && typeof detail.supervisor_ready !== "boolean")
+		)
+			return;
+		if (detail.running === true) {
+			if (!sessionId(detail.session_id) || detail.exit_code !== null) return;
+		} else if (detail.running !== false || detail.exit_code !== 0 || Object.hasOwn(detail, "session_id")) return;
+		if (!Array.isArray(value.content) || value.content.length !== 1) return;
+		const block = data(value.content[0]);
+		if (
+			!block ||
+			Object.keys(block).length !== 2 ||
+			block.type !== "text" ||
+			typeof block.text !== "string" ||
+			block.text.length > 524288
+		)
+			return;
+		const parsed = data(JSON.parse(block.text));
+		if (
+			!parsed ||
+			Object.keys(parsed).length !== Object.keys(detail).length ||
+			!Object.keys(detail).every((key) => Object.hasOwn(parsed, key) && parsed[key] === detail[key])
+		)
+			return;
+		return {
+			output: detail.output,
+			running: detail.running,
+			session: detail.running ? (detail.session_id as string | number) : undefined,
+		};
+	} catch {
+		return;
+	}
+}
+
+// This recognizes only fixed ordinary audit text, never arbitrary evidence or direct completion reports.
+// Correlation is display-only: neither these IDs nor history rows restore execution authority.
+export function localJobAudit(message: CustomMessage): { scope: string; journal: string } | undefined {
+	try {
+		if (message.customType !== "code-mode-evidence" || message.display !== true) return;
+		const d = data(message.details);
+		if (
+			!d ||
+			d.auditOnly !== true ||
+			d.isError !== false ||
+			!id(d.scopeId) ||
+			!id(d.journalId) ||
+			!id(d.toolCallId) ||
+			!["exec_command", "write_stdin"].includes(d.toolName as string) ||
+			Object.keys(d).sort().join() !== "auditOnly,isError,journalId,scopeId,toolCallId,toolName"
+		)
+			return;
+		if (!Array.isArray(message.content) || message.content.length !== 1) return;
+		const block = data(message.content[0]);
+		if (
+			!block ||
+			Object.keys(block).length !== 2 ||
+			block.type !== "text" ||
+			block.text !== `Code mode: ${d.toolName} returned.`
+		)
+			return;
+		return { scope: d.scopeId, journal: d.journalId };
+	} catch {
+		return;
+	}
+}
+
+function preview(text: string): string {
+	return stripTerminalSequences(text)
+		.replace(/[\u0000-\u001f\u007f-\u009f\u061c\u200e\u200f\u202a-\u202e\u2066-\u2069]/g, " ")
