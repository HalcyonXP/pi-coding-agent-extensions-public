+		.trim();
+}
+
+/** Native transcript component. Full native components remain available through the existing expand control.
+ * A group holds at most 64 calls and 64 audits; overflow falls back outside the group, never disappears.
+ * Replayed audit-only groups report returned calls, not live jobs or confirmed cleanup.
+ */
+export class LocalJobGroup extends Container {
+	private calls = new Map<string, Call>();
+	private jobs: Job[] = [];
+	private audits = new Map<string, CustomMessageComponent>();
+	private body = new Container();
+	private expanded = false;
+	readonly scopeId: string;
+	private requestRender: () => void;
+	constructor(scopeId: string, requestRender: () => void) {
+		super();
+		this.scopeId = scopeId;
+		this.requestRender = requestRender;
+		this.addChild(
+			new MouseRegion(this.body, (event) => {
+				if (event.type !== "click" || event.button !== "left") return undefined;
+				this.setExpanded(!this.expanded);
+				this.requestRender();
+				return { handled: true };
+			}),
+		);
+	}
+	hasCall(callId: string): boolean {
+		return this.calls.has(callId);
+	}
+	addCall(start: Start, component: ToolExecutionComponent, hadUpdates = false): boolean {
+		if (
+			!localJobStart(start) ||
+			start.scopeId !== this.scopeId ||
+			this.calls.has(start.toolCallId) ||
+			this.calls.size >= MAX_RECORDS
+		)
+			return false;
+		const session = start.toolName === "write_stdin" ? (stdin(start.args)?.session_id as string | number) : undefined;
+		let job = session ? this.jobs.find((j) => j.session === session) : undefined;
+		if (!job) {
+			job = { number: this.jobs.length + 1, status: "call pending", preview: "", session };
+			this.jobs.push(job);
+		}
+		this.calls.set(start.toolCallId, {
+			start,
+			args: JSON.stringify(argumentsFor(start)),
+			component,
+			job,
+			prominent: hadUpdates,
+		});
+		component.setExpanded(this.expanded);
+		return true;
+	}
+	updateCall(
+		callId: string,
+		result: Result,
+		partial = false,
+		correlation?: { scopeId?: string; toolName: string },
+	): void {
+		const call = this.calls.get(callId);
+		if (!call) return;
+		const summary = localJobResult(result);
+		if (
+			partial ||
+			!summary ||
+			(correlation && (correlation.scopeId !== this.scopeId || correlation.toolName !== call.start.toolName))
+		)
+			call.prominent = true;
+		if (call.prominent) {
+			let exit: unknown;
+			try {
+				exit = data(data(result)?.details)?.exit_code;
+			} catch {
+				/* Unknown stays prominent. */
+			}
+			call.job.status = result.isError
+				? "error — see details"
+				: typeof exit === "number" && Number.isSafeInteger(exit) && exit !== 0
+					? `error (exit ${exit}) — see details`
+					: "update — see details";
+			return;
+		}
+		if (summary) {
+			// A mismatched response cannot merge separate jobs or manufacture a successful correlation.
+			if (
+				summary.session &&
+				((call.job.session && summary.session !== call.job.session) ||
+					this.jobs.some((job) => job !== call.job && job.session === summary.session))
+			) {
+				call.prominent = true;
+				call.job.status = "unmatched result — see details";
+				return;
+			}
+			call.job.session ??= summary.session;
+			call.job.status = summary.running ? "running" : "exited 0";
+			if (summary.output) {
+				const text = preview(summary.output);
+				call.job.preview = call.job.preview ? `${call.job.preview} | ${text}` : text;
+				if (call.job.preview.length > 512) call.job.preview = `${call.job.preview.slice(0, 511)}…`;
+			}
+		}
+	}
+	addAudit(journal: string, component: CustomMessageComponent): boolean {
+		if (this.audits.has(journal) || this.audits.size >= MAX_RECORDS) return false;
+		this.audits.set(journal, component);
+		component.setExpanded(this.expanded);
+		return true;
+	}
+	setExpanded(expanded: boolean): void {
+		this.expanded = expanded;
+		for (const c of this.calls.values()) c.component.setExpanded(expanded);
+		for (const c of this.audits.values()) c.setExpanded(expanded);
+	}
+	setShowImages(show: boolean): void {
+		for (const c of this.calls.values()) c.component.setShowImages(show);
+	}
+	setImageWidthCells(width: number): void {
+		for (const c of this.calls.values()) c.component.setImageWidthCells(width);
+	}
+	override invalidate(): void {
+		for (const c of this.calls.values()) c.component.invalidate();
+		for (const c of this.audits.values()) c.invalidate();
+		super.invalidate();
+	}
+	override render(width: number): string[] {
+		if (!Number.isFinite(width)) return [];
+		width = Math.floor(width);
+		if (width <= 0) return [];
+		this.body.clear();
+		const line = (text: string) => this.body.addChild(new Text(truncateToWidth(text, width, "…"), 0, 0));
+		const title = this.jobs.length
+			? `Local job updates · ${this.jobs.length} observed`
+			: "Local tool audit · history only";
+		line(
+			`${theme.fg("muted", `${title} · ${this.audits.size} call audits`)} · ${keyHint("app.tools.expand", this.expanded ? "collapse" : "details")}`,
+		);
+		if (this.expanded) {
+			this.body.addChild(new Text(`Scope: ${preview(this.scopeId)}`, 0, 0));
+			for (const [callId, c] of this.calls) {
+				this.body.addChild(new Text(`Call: ${preview(callId)} · ${c.start.toolName}\n${preview(c.args)}`, 0, 0));
+				this.body.addChild(c.component);
+			}
+			for (const [journal, c] of this.audits) {
+				this.body.addChild(new Text(`Audit: ${preview(journal)}`, 0, 0));
+				this.body.addChild(c);
+			}
+		} else {
+			for (const job of this.jobs.slice(0, MAX_ROWS)) {
+				const text = `#${job.number} ${job.status}${job.preview ? ` · ${job.preview}` : ""}`;
+				line(theme.fg(job.status.includes("error") ? "error" : "toolOutput", text));
+			}
+			if (this.jobs.length > MAX_ROWS)
+				line(theme.fg("muted", `+${this.jobs.length - MAX_ROWS} more job rows — expand`));
+			for (const c of this.calls.values()) if (c.prominent) this.body.addChild(c.component);
+		}
+		return super.render(width);
+	}
+}
