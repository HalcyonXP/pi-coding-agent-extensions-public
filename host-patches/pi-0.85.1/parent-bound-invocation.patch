diff --git a/packages/coding-agent/src/modes/interactive/local-poll-presentation.ts b/packages/coding-agent/src/modes/interactive/local-poll-presentation.ts
new file mode 100644
index 0000000..16e5eb3
--- /dev/null
+++ b/packages/coding-agent/src/modes/interactive/local-poll-presentation.ts
@@ -0,0 +1,62 @@
+import type { AgentSessionEvent } from "../../core/agent-session.ts";
+import { localJobStart } from "./components/local-job-group.ts";
+
+type Start = Extract<AgentSessionEvent, { type: "tool_execution_start" }>;
+
+/** Presentation only: raw native events, approvals and ownership remain untouched.
+ * Hold at most the native two scopes × four outstanding calls. Overflow stays visible.
+ * Normal agent_end is not scope completion; deferred calls survive foreground turns.
+ */
+export class LocalPollPresentation {
+	private pending = new Map<string, { start: Start; revealed: boolean; deferrable: boolean; updated: boolean }>();
+	private updatedStarts = new WeakSet<AgentSessionEvent>();
+
+	/** Display-only memory across redraw; never part of raw SDK/RPC events. */
+	hadUpdates(start: AgentSessionEvent): boolean {
+		return this.updatedStarts.has(start);
+	}
+
+	accept(event: AgentSessionEvent): AgentSessionEvent[] {
+		if (event.type === "tool_execution_start") {
+			if (localJobStart(event) && !this.pending.has(event.toolCallId) && this.pending.size < 8) {
+				const deferrable = event.toolName === "write_stdin" && event.localPoll === "pending";
+				this.pending.set(event.toolCallId, { start: event, revealed: !deferrable, deferrable, updated: false });
+				return deferrable ? [] : [event];
+			}
+		} else if (event.type === "tool_execution_update" || event.type === "tool_execution_end") {
+			const held = this.pending.get(event.toolCallId);
+			if (held && held.start.scopeId === event.scopeId && held.start.toolName === event.toolName) {
+				if (event.type === "tool_execution_update") held.updated = true;
+				if (event.type === "tool_execution_end") {
+					this.pending.delete(event.toolCallId);
+					if (
+						held.deferrable &&
+						!held.updated &&
+						!held.revealed &&
+						event.localPoll === "quiet" &&
+						event.isError === false
+					)
+						return [];
+				}
+				if (held.revealed) return [event];
+				held.revealed = true;
+				if (held.updated) this.updatedStarts.add(held.start);
+				return [held.start, event];
+			}
+		}
+		return [event];
+	}
+
+	/** A history redraw is not cancellation. Re-present surviving native calls on their next result. */
+	resetPresentation(nativePending: ReadonlySet<string>): void {
+		for (const [id, held] of this.pending) {
+			if (!nativePending.has(id)) this.pending.delete(id);
+			else held.revealed = false;
+		}
+	}
+
+	clear(): void {
+		this.pending.clear();
+		this.updatedStarts = new WeakSet();
+	}
+}
