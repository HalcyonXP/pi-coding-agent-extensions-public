+		expect(f.groups()).toHaveLength(2);
+	});
+	it("sanitizes control/directional text and bounds compact Unicode rows", async () => {
+		const f = display(),
+			s = start("unicode");
+		await f.emit(s);
+		await f.finish(s, ended("safe\u001b]0;not-a-title\u0007\u202e\n界🐄".repeat(80)));
+		for (const w of [1, 16, 31, 80])
+			for (const line of f.groups()[0].render(w)) {
+				expect(visibleWidth(line)).toBeLessThanOrEqual(w);
+				expect(stripTerminalSequences(line)).not.toMatch(/[\u001b\u202e]/);
+			}
+		expect(f.groups()[0].render(0)).toEqual([]);
+		expect(f.groups()[0].render(-1)).toEqual([]);
+		expect(f.groups()[0].render(0.5)).toEqual([]);
+	});
+	it("bounds records and leaves overflow as native cards, not silent eviction", async () => {
+		const f = display();
+		for (let n = 0; n < 65; n++) {
+			const s = start(`s-${n}`);
+			await f.emit(s);
+			await f.finish(s, ended(`RESULT_${n}`));
+		}
+		expect(f.view.chatContainer.children).toHaveLength(2);
+		expect(f.view.chatContainer.children[1]).toBeInstanceOf(ToolExecutionComponent);
+		expect(f.frame()).toContain("RESULT_64");
+		expect(f.frame()).toContain("more job rows");
+		f.groups()[0].setExpanded(true);
+		expect(f.frame()).toContain("RESULT_63");
+	});
+	it("bounds audit retention and leaves duplicate/overflow messages visible", () => {
+		const f = display();
+		for (let n = 0; n < 65; n++) f.view.addMessageToChat(audit(String(n)));
+		expect(f.groups()).toHaveLength(1);
+		expect(f.view.chatContainer.children).toHaveLength(2);
+		expect(f.frame()).toContain("64 call audits");
+		f.view.addMessageToChat(audit("0"));
+		expect(f.view.chatContainer.children).toHaveLength(3);
+	});
+	it("groups only exact ordinary audits; image/source/direct/error/custom content remains native", () => {
+		for (const change of [
+			(m: any) => {
+				m.details.isError = true;
+			},
+			(m: any) => {
+				m.details.kind = "unified_exec_completion";
+			},
+			(m: any) => m.content.push({ type: "image", data: tinyBmp(), mimeType: "image/bmp" }),
+			(m: any) => {
+				m.details.sourceEvidencePresent = true;
+			},
+			(m: any) => {
+				m.content[0].text = "IMPORTANT_EVIDENCE";
+			},
+			(m: any) => delete m.details.journalId,
+		]) {
+			const f = display(),
+				m = audit("x");
+			change(m);
+			expect(localJobAudit(m)).toBeUndefined();
+			f.view.addMessageToChat(m);
+			expect(f.groups()).toHaveLength(0);
+			expect(f.frame()).toContain("code-mode-evidence");
+		}
+	});
+	it("does not bypass an existing custom message renderer", () => {
+		const f = display(undefined, () => new Text("CUSTOM_EVIDENCE"));
+		f.view.addMessageToChat(audit("x"));
+		expect(f.groups()).toHaveLength(0);
+		expect(f.frame()).toContain("CUSTOM_EVIDENCE");
+	});
+	it("history replay has audit counts only, no restored running job claims or message mutation", () => {
+		const f = display(),
+			messages = [audit("1"), audit("2")],
+			before = JSON.stringify(messages);
+		f.view.renderSessionItems(messages);
+		expect(f.frame().split("\n")).toHaveLength(1);
+		expect(f.frame()).toContain("history only");
+		expect(f.frame()).not.toContain("running");
+		expect(JSON.stringify(messages)).toBe(before);
+		f.groups()[0].setExpanded(true);
+		expect(f.frame()).toContain("Code mode: exec_command returned.");
+		f.view.renderCurrentSessionState();
+		expect(f.groups()).toHaveLength(0);
+	});
+	it("reconstructs a still-pending scoped start after full redraw without losing its late result", async () => {
+		const f = display(),
+			s = start("slow-start");
+		await f.emit(s);
+		f.view.renderCurrentSessionState();
+		expect(f.frame()).toBe("");
+		await f.finish(s, ended("AFTER_REDRAW"));
+		expect(f.frame()).toContain("AFTER_REDRAW");
+		expect(f.view.pendingTools.size).toBe(0);
+	});
+	it("retains update prominence across redraw even when the terminal shape could otherwise compact", async () => {
+		const f = display(),
+			s = start("updated-start");
+		await f.emit(s);
+		await f.emit({
+			type: "tool_execution_update",
+			toolCallId: s.toolCallId,
+			toolName: s.toolName,
+			scopeId: s.scopeId,
+			args: s.args,
+			partialResult: text("BEFORE_REDRAW_UPDATE"),
+		});
+		f.view.renderCurrentSessionState();
+		await f.finish(s, ended("AFTER_UPDATED_REDRAW"));
+		expect(f.frame()).toContain("AFTER_UPDATED_REDRAW");
+		expect(f.frame().split("\n").length).toBeGreaterThan(2);
+	});
+	it("does not let foreground agent-end/start close the group or pending native call", async () => {
+		const f = display(),
+			s = start("long");
+		await f.emit(s);
+		await f.emit({ type: "agent_end", messages: [], willRetry: false });
+		await f.emit({ type: "agent_start" });
+		expect(f.groups()).toHaveLength(1);
+		expect(f.view.pendingTools.size).toBe(1);
+		await f.finish(s, ended());
+		expect(f.frame()).toContain("exited 0");
+	});
+	it("keeps an interrupted pending call visibly failed rather than indefinitely pending", async () => {
+		const f = display(),
+			s = start("interrupt");
+		await f.emit(s);
+		f.view.streamingComponent = { updateContent() {} };
+		await f.emit({
+			type: "message_end",
+			message: { role: "assistant", content: [], stopReason: "aborted", timestamp: 0 } as any,
+		});
+		expect(f.frame()).toContain("Operation aborted");
+		expect(f.frame()).toContain("error");
+		expect(f.view.pendingTools.size).toBe(0);
