@@ -0,0 +1,355 @@
+import { uuidv7 } from "@earendil-works/pi-ai";
+import type {
+	AgentScopedResult,
+	AgentToolEvidence,
+	AgentToolInvocation,
+	AgentToolResourceScope,
+	AgentToolScope,
+	AgentToolScopeOptions,
+} from "./types.ts";
+
+type Backend = {
+	invoke: AgentToolInvocation["invoke"];
+	close(): Promise<void>;
+	publishEvidence?: (evidence: AgentToolEvidence) => Promise<void>;
+	notify?: (text: string) => Promise<boolean>;
+};
+type Resource = { close: () => Promise<void> };
+type RecordState = {
+	id: string;
+	deadline: number;
+	epoch?: AbortSignal;
+	controller: AbortController;
+	resources: Set<Resource>;
+	backend?: Backend;
+	backendClosed: boolean;
+	cleanupPending: number;
+	state: "active" | "draining" | "closed";
+	closing?: Promise<void>;
+	timer?: ReturnType<typeof setTimeout>;
+	revoke: () => void;
+	api?: AgentToolScope;
+	onResult?: AgentToolScopeOptions["onResult"];
+	resolveImageReference?: AgentToolScopeOptions["resolveImageReference"];
+	publicationCalls: number;
+	publicationPending: number;
+};
+
+/** Native Agent-owned admission, not extension/module-owned quota or caller-ID authority.
+ * A shorter test lifetime is allowed; a caller cannot expand the six-minute ceiling.
+ */
+export class ToolScopeRegistry {
+	private readonly records = new Map<AgentToolScope, RecordState>();
+	private readonly resourceScopes = new WeakMap<AgentToolResourceScope, RecordState>();
+	private readonly lifetimeMs: number;
+	constructor(lifetimeMs = 360_000) {
+		this.lifetimeMs = lifetimeMs;
+		if (!Number.isSafeInteger(lifetimeMs) || lifetimeMs < 1 || lifetimeMs > 360_000)
+			throw new Error("Invalid host scope lifetime");
+	}
+	get size(): number {
+		return this.records.size;
+	}
+	/** Passive snapshot: does not issue a capability, reset quota or trigger work. */
+	get status(): { readonly active: number; readonly draining: number } {
+		let active = 0,
+			draining = 0;
+		for (const record of this.records.values()) {
+			if (record.state === "active") active++;
+			else if (record.state === "draining") draining++;
+		}
+		return Object.freeze({ active, draining });
+	}
+
+	private expire(record: RecordState): void {
+		if (record.state === "active" && (record.epoch?.aborted || performance.now() >= record.deadline)) record.revoke();
+	}
+
+	open(
+		epoch: AbortSignal,
+		create: (scope: AgentToolResourceScope) => Backend,
+		options?: AgentToolScopeOptions,
+	): AgentToolScope {
+		for (const record of this.records.values()) this.expire(record);
+		if (
+			epoch.aborted ||
+			this.records.size >= 2 ||
+			[...this.records.values()].some((record) => record.state !== "active")
+		) {
+			throw new Error("Durable scope admission unavailable or prior cleanup incomplete");
+		}
+		const record: RecordState = {
+			id: uuidv7(),
+			deadline: performance.now() + this.lifetimeMs,
+			epoch,
+			controller: new AbortController(),
+			resources: new Set(),
+			backendClosed: false,
+			cleanupPending: 0,
+			state: "active",
+			onResult: options?.onResult,
+			resolveImageReference: options?.resolveImageReference,
+			publicationCalls: 0,
+			publicationPending: 0,
+			revoke: () => {},
+		};
+		const expire = () => this.expire(record);
+		const assertCurrent = () => {
+			expire();
+			if (
+				record.state !== "active" ||
+				record.controller.signal.aborted ||
+				record.epoch?.aborted ||
+				performance.now() >= record.deadline
+			)
+				throw new Error("Durable tool scope is expired or revoked");
+		};
+		const finish = () => {
+			if (record.state !== "draining" || !record.backendClosed || record.cleanupPending || record.resources.size)
+				return;
+			record.state = "closed";
+			record.epoch?.removeEventListener("abort", record.revoke);
+			record.epoch = undefined;
+			record.onResult = undefined;
+			record.resolveImageReference = undefined;
+			this.resourceScopes.delete(resourceScope);
+			if (record.api) this.records.delete(record.api);
+		};
+		const ownResource = (close: () => Promise<void>) => {
+			assertCurrent();
+			if (typeof close !== "function" || record.resources.size >= 16)
+				throw new Error("Invalid or excessive scope resources");
+			const resource: Resource = { close };
+			record.resources.add(resource);
+			// Only a native tool receives this release closure, never generated JavaScript.
+			return () => {
+				record.resources.delete(resource);
+				finish();
+			};
+		};
+		const resourceScope: AgentToolResourceScope = Object.freeze({
+			id: record.id,
+			get signal() {
+				expire();
+				return record.controller.signal;
+			},
+			ownResource,
+		});
+		this.resourceScopes.set(resourceScope, record);
+		const close = (): Promise<void> => {
+			if (record.state === "closed") return Promise.resolve();
+			if (record.closing) return record.closing;
+			let resolve!: () => void;
+			let reject!: (error: unknown) => void;
+			record.closing = new Promise<void>((done, fail) => {
+				resolve = done;
+				reject = fail;
+			});
+			record.state = "draining";
+			clearTimeout(record.timer);
+			record.controller.abort();
+			void (async () => {
+				const drain = Promise.resolve()
+					.then(() => record.backend?.close())
+					.then(() => {
+						record.backendClosed = true;
+						record.backend = undefined;
+					});
