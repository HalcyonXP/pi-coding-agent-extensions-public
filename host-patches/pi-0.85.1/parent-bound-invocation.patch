+/** Observe only serialized native request bytes; no data transformation or retry. */
+export function observeSerializedRequest(
+	options: Pick<StreamOptions, "onSerializedRequest"> | undefined,
+	body: unknown,
+): void {
+	try {
+		const observed: unknown = options?.onSerializedRequest?.(typeof body === "string" ? body : undefined);
+		// Do not await observer work or turn a rejected observer into an
+		// unhandled rejection that can interrupt the native request.
+		if (observed !== undefined) void Promise.resolve(observed).catch(() => {});
+	} catch {
+		/* An observation failure is not permission to change native transport. */
+	}
+}
