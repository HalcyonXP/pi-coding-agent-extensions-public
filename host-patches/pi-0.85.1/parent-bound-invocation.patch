diff --git a/packages/agent/src/local-poll.ts b/packages/agent/src/local-poll.ts
new file mode 100644
index 0000000..bdd1da5
--- /dev/null
+++ b/packages/agent/src/local-poll.ts
@@ -0,0 +1,87 @@
+// Native presentation classification, not guest authority or a token/billing meter.
+// Tools opt in only when empty stdin is local I/O. Unknown/changed outcomes stay visible.
+function dataObject(value: unknown): Record<string, unknown> | undefined {
+	if (!value || typeof value !== "object" || Array.isArray(value)) return;
+	const prototype = Object.getPrototypeOf(value);
+	if (prototype !== Object.prototype && prototype !== null) return;
+	const result: Record<string, unknown> = Object.create(null);
+	for (const key of Reflect.ownKeys(value)) {
+		if (typeof key !== "string") return;
+		const descriptor = Object.getOwnPropertyDescriptor(value, key);
+		if (!descriptor || !("value" in descriptor)) return;
+		result[key] = descriptor.value;
+	}
+	return result;
+}
+
+// Public lookup IDs only. Scope/call identity remains native and string-valued.
+function sessionId(value: unknown): value is string | number {
+	return (
+		(typeof value === "string" && value.length > 0 && value.length <= 1024) ||
+		(typeof value === "number" && Number.isInteger(value) && value > 0 && value <= 2147483647)
+	);
+}
+
+export function emptyStdinPoll(args: unknown): boolean {
+	try {
+		const value = dataObject(args);
+		return Boolean(
+			value &&
+				Object.keys(value).every((key) =>
+					["session_id", "chars", "yield_time_ms", "max_output_tokens"].includes(key),
+				) &&
+				sessionId(value.session_id) &&
+				(!Object.hasOwn(value, "chars") || value.chars === ""),
+		);
+	} catch {
+		return false;
+	}
+}
+
+export function quietStdinResult(result: unknown, isError: boolean, requestedSession?: unknown): boolean {
+	try {
+		if (isError !== false) return false;
+		const value = dataObject(result);
+		if (!value) return false;
+		// Native hooks may retain these absent optional fields; any defined value stays visible.
+		for (const key of ["usage", "terminate"]) if (value[key] === undefined) delete value[key];
+		if (Object.keys(value).some((key) => !["content", "details", "isError"].includes(key))) return false;
+		if (Object.hasOwn(value, "isError") && value.isError !== false) return false;
+		const details = dataObject(value.details);
+		// Unified exec's JS record has termination: undefined; its JSON intentionally omits it.
+		if (details?.termination === undefined) delete details?.termination;
+		if (
+			!details ||
+			Object.keys(details).some(
+				(key) =>
+					!["session_id", "output", "exit_code", "running", "supervisor_ready", "truncated_bytes"].includes(key),
+			) ||
+			!sessionId(details.session_id) ||
+			(requestedSession !== undefined && details.session_id !== requestedSession) ||
+			details.running !== true ||
+			details.exit_code !== null ||
+			details.output !== "" ||
+			details.truncated_bytes !== 0 ||
+			(Object.hasOwn(details, "supervisor_ready") && typeof details.supervisor_ready !== "boolean")
+		)
+			return false;
+		if (!Array.isArray(value.content) || value.content.length !== 1) return false;
+		const block = dataObject(value.content[0]);
+		if (
+			!block ||
+			Object.keys(block).length !== 2 ||
+			block.type !== "text" ||
+			typeof block.text !== "string" ||
+			block.text.length > 4096
+		)
+			return false;
+		const text = dataObject(JSON.parse(block.text));
+		return Boolean(
+			text &&
+				Object.keys(text).length === Object.keys(details).length &&
+				Object.keys(details).every((key) => Object.hasOwn(text, key) && text[key] === details[key]),
+		);
+	} catch {
+		return false;
+	}
+}
