+			...resourceScope,
+			get signal() {
+				expire();
+				return record.controller.signal;
+			},
+			get state() {
+				expire();
+				return record.state;
+			},
+			invoke: (...args: Parameters<AgentToolInvocation["invoke"]>) => {
+				try {
+					assertCurrent();
+					return record.backend!.invoke(...args).then((outcome) => {
+						assertCurrent();
+						if (outcome.result.terminate) void close().catch(() => {});
+						return outcome;
+					});
+				} catch {
+					return Promise.reject(new Error("Durable tool scope is expired or unavailable"));
+				}
+			},
+			close,
+			canNotify() {
+				assertCurrent();
+				return Boolean(record.onResult && record.backend?.notify);
+			},
+			async notify(text: string) {
+				assertCurrent();
+				if (!record.onResult || !record.backend?.notify) throw new Error("Protected notifications are unavailable");
+				if (typeof text !== "string" || text.length > 65536 || new TextEncoder().encode(text).byteLength > 65536)
