+		item: { type: "message", id: "msg_fixture", role: "assistant", status: "in_progress", content: [] },
+	},
+	{ type: "response.content_part.added", part: { type: "output_text", text: "" } },
+	{ type: "response.output_text.delta", delta: "done" },
+	{
+		type: "response.output_item.done",
+		item: {
+			type: "message",
+			id: "msg_fixture",
+			role: "assistant",
+			status: "completed",
+			content: [{ type: "output_text", text: "done" }],
+		},
+	},
+	{
+		type: "response.completed",
+		response: {
+			id: "resp_fixture",
+			status: "completed",
+			usage: { input_tokens: 5, output_tokens: 1, total_tokens: 6, input_tokens_details: { cached_tokens: 0 } },
+		},
+	},
+]
+	.map((event) => `data: ${JSON.stringify(event)}\n\n`)
+	.join("");
+const token = `fixture.${Buffer.from(JSON.stringify({ "https://api.openai.com/auth": { chatgpt_account_id: "synthetic_account" } })).toString("base64url")}.fixture`;
+const context: Context = { messages: [{ role: "user", content: "original", timestamp: 1 }] };
+for (const route of ["responses", "codex"] as const)
+	for (const mode of ["unchanged", "toJSON", "getter", "observer-error", "observer-rejection", "observer-pending"]) {
+		it(`native ${route} observes serialized HTTP input exactly once without replacing transport: ${mode}`, async () => {
+			const model: Model<"openai-codex-responses" | "openai-responses"> = {
+				id: "gpt-5.4",
+				name: "Synthetic",
+				provider: route === "codex" ? "openai-codex" : "openai",
+				api: route === "codex" ? "openai-codex-responses" : "openai-responses",
+				baseUrl: route === "codex" ? "https://chatgpt.com/backend-api" : "https://api.openai.com/v1",
+				reasoning: false,
+				input: ["text"],
+				cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
+				contextWindow: 4096,
+				maxTokens: 128,
+			};
+			let requests = 0,
+				conversions = 0;
+			const observed: string[] = [],
+				sent: string[] = [];
+			const redacted = [{ role: "user", content: [{ type: "input_text", text: "redacted" }] }];
+			try {
+				const options: SimpleStreamOptions = {
+					apiKey: token,
+					transport: "sse",
+					maxRetries: 0,
+					signal: AbortSignal.timeout(5000),
+					onPayload: (payload) => {
+						if (mode === "toJSON")
+							return {
+								...(payload as object),
+								toJSON() {
+									conversions++;
+									return { ...(payload as object), input: redacted };
+								},
+							};
+						if (mode === "getter")
+							return {
+								...(payload as object),
+								get input() {
+									conversions++;
+									return redacted;
+								},
+							};
+						return undefined;
+					},
+					onSerializedRequest: (body) => {
+						expect(typeof body).toBe("string");
+						observed.push(body!);
+						if (mode === "observer-error") throw Error("Read-only observation failure");
+						if (mode === "observer-rejection") return Promise.reject(Error("Read-only asynchronous failure"));
+						if (mode === "observer-pending") return new Promise<void>(() => {});
+					},
+					fetch: async (_url, init) => {
+						requests++;
+						const body =
+							typeof init?.body === "string"
+								? init.body
+								: Buffer.from(zstdDecompressSync(init!.body as Uint8Array)).toString("utf8");
+						sent.push(body);
+						return new Response(events, { status: 200, headers: { "content-type": "text/event-stream" } });
+					},
+				};
+				const output =
+					route === "codex"
+						? codex({ ...model, api: "openai-codex-responses" }, context, options)
+						: responses({ ...model, api: "openai-responses" }, context, options);
+				const result = await output.result();
+				expect(result.stopReason).toBe("stop");
+				expect(requests).toBe(1);
+				expect(observed).toEqual(sent);
+				expect(conversions).toBe(mode === "toJSON" || mode === "getter" ? 1 : 0);
+				expect(observed[0]).not.toContain(token);
+				expect(JSON.parse(observed[0]).input[0].content[0].text).toBe(
+					mode === "toJSON" || mode === "getter" ? "redacted" : "original",
+				);
+			} finally {
+				closeOpenAICodexWebSocketSessions();
+			}
+		});
+	}
