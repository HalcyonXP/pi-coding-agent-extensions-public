new file mode 100644
index 0000000..f3e9f69
--- /dev/null
+++ b/packages/coding-agent/test/suite/tool-context.test.ts
@@ -0,0 +1,101 @@
+import { fauxAssistantMessage, fauxToolCall } from "@earendil-works/pi-ai";
+import { Type } from "typebox";
+import { expect, it } from "vitest";
+import { convertResponsesMessages } from "../../../ai/src/api/openai-responses-shared.ts";
+import { createHarness } from "./harness.ts";
+
+// Native compaction entries/navigation and extension hooks, with a real Responses
+// serializer and synthetic stream. No model service or installed-artifact claim.
+for (const mode of ["compaction", "context-hook", "payload-hook"])
+	it(`native text context after ${mode}`, async () => {
+		let captured: unknown;
+		const h = await createHarness({
+			tools: [],
+			extensionFactories: [
+				(pi) => {
+					pi.registerTool({
+						name: "context_probe",
+						label: "Context",
+						description: "Native context fixture",
+						parameters: Type.Object({}),
+						execute: async (_id, _args, _signal, _update, ctx) => {
+							captured = ctx.tools!.getTextContext!();
+							return { content: [{ type: "text", text: "read" }], details: {} };
+						},
+					});
+					pi.on("context", (event) =>
+						mode === "context-hook"
+							? {
+									messages: event.messages.map((m) =>
+										m.role === "user"
+											? {
+													...m,
+													content: `hook ${
+														typeof m.content === "string"
+															? m.content
+															: m.content
+																	.filter((b) => b.type === "text")
+																	.map((b) => b.text)
+																	.join("\n")
+													}`,
+												}
+											: m,
+									),
+								}
+							: undefined,
+					);
+				},
+			],
+		});
+		const model = h.session.agent.state.model;
+		const stream = h.session.agent.streamFunction;
+		const onPayload = h.session.agent.onPayload;
+		const fetch = globalThis.fetch;
+		let externalAttempts = 0;
+		globalThis.fetch = async () => {
+			externalAttempts++;
+			throw Error("Unexpected network in native context fixture");
+		};
+		try {
+			h.sessionManager.appendMessage({ role: "user", content: "discarded raw ancestry", timestamp: 1 });
+			h.sessionManager.appendMessage(fauxAssistantMessage("discarded answer"));
+			const kept = h.sessionManager.appendMessage({ role: "user", content: "kept", timestamp: 2 });
+			const compacted = h.sessionManager.appendCompaction("native summary remains model-only", kept, 20);
+			h.sessionManager.appendMessage(fauxAssistantMessage("other branch commentary"));
+			expect(await h.session.navigateTree(compacted, { summarize: false })).toMatchObject({ cancelled: false });
+			expect(JSON.stringify(h.sessionManager.getBranch())).toContain("discarded raw ancestry");
+			expect(JSON.stringify(h.session.messages)).not.toContain("discarded raw ancestry");
+			h.session.agent.state.model = { ...model, api: "openai-responses" };
+			h.session.agent.onPayload = async (payload, requestModel) => {
+				const replacement = await onPayload?.(payload, requestModel);
+				return mode === "payload-hook" ? { input: [{ role: "user", content: "redacted" }] } : replacement;
+			};
+			h.session.agent.streamFunction = async (requestModel, context, options) => {
+				const payload = {
+					input: convertResponsesMessages(requestModel, context, new Set(["openai", "openai-codex"])),
+				};
+				const replacement = await options?.onPayload?.(payload, requestModel);
+				options?.onSerializedRequest?.(JSON.stringify(replacement === undefined ? payload : replacement));
+				return stream(model, context, { ...options, onPayload: undefined, onSerializedRequest: undefined });
+			};
+			h.setResponses([
+				fauxAssistantMessage([fauxToolCall("context_probe", {})], { stopReason: "toolUse" }),
+				fauxAssistantMessage("done"),
+			]);
+			await h.session.prompt("latest");
+			if (mode === "payload-hook") expect(captured).toBeUndefined();
+			else
+				expect(captured).toEqual([
+					{ role: "user", content: [{ type: "text", text: mode === "context-hook" ? "hook kept" : "kept" }] },
+					{ role: "user", content: [{ type: "text", text: mode === "context-hook" ? "hook latest" : "latest" }] },
+				]);
+			expect(externalAttempts).toBe(0);
+			expect(h.settingsManager.getCompactionSettings().enabled).toBe(true);
+		} finally {
+			globalThis.fetch = fetch;
+			h.session.agent.onPayload = onPayload;
+			h.session.agent.streamFunction = stream;
+			h.session.agent.state.model = model;
+			h.cleanup();
+		}
+	});
