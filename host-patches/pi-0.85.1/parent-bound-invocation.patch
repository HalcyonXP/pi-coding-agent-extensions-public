+import { describe, expect, it } from "vitest";
+import { ToolContextSnapshot } from "../src/tool-context.ts";
+import type { AgentMessage, AgentToolTextContextCapture } from "../src/types.ts";
+
+const user = (text: string): AgentMessage => ({ role: "user", content: text, timestamp: 1 });
+const assistant = (...text: string[]): AgentMessage =>
+	({ role: "assistant", content: text.map((text) => ({ type: "text", text })) }) as AgentMessage;
+const wire = (role: string, ...text: string[]) => ({
+	role,
+	content: text.map((text) => ({ type: role === "user" ? "input_text" : "output_text", text })),
+});
+function confirm(capture: AgentToolTextContextCapture, payload: unknown) {
+	capture.confirm(JSON.stringify(payload));
+}
+function fixture(messages: AgentMessage[]) {
+	const snapshot = new ToolContextSnapshot(),
+		epoch = new AbortController();
+	const capture = snapshot.begin(messages, epoch.signal, "openai-responses");
+	return { snapshot, epoch, capture, read: () => snapshot.read(epoch.signal) };
+}
+
+describe("native payload-confirmed context consistency, not invocation authority", () => {
+	it("detaches only recent native user/assistant text and requires successful completion", () => {
+		const messages = [
+			user("old"),
+			user("first"),
+			assistant("a", "b"),
+			{
+				role: "custom",
+				get content() {
+					throw Error("must not read protected text");
+				},
+			} as unknown as AgentMessage,
+			user("last"),
+			assistant("later"),
+		];
+		const f = fixture(messages);
+		expect(f.read()).toBeUndefined();
+		confirm(f.capture!, {
