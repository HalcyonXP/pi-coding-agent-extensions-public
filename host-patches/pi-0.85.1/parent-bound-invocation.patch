@@ -0,0 +1,154 @@
+import {
+	type AssistantMessage,
+	type AssistantMessageEvent,
+	EventStream,
+	type Message,
+	type Model,
+} from "@earendil-works/pi-ai";
+import { Type } from "typebox";
+import { expect, it } from "vitest";
+import { convertResponsesMessages } from "../../ai/src/api/openai-responses-shared.ts";
+import { Agent, type AgentTool, type AgentToolInvocation } from "../src/index.ts";
+import type { AgentToolTextContext } from "../src/types.ts";
+
+// Actual native Agent and Responses serializer, synthetic stream only. This is
+// not an HTTP/provider/artifact acceptance test and imports no real auth.
+for (const api of ["openai-responses", "openai-codex-responses"] as const) {
+	for (const mode of [
+		"approved",
+		"convert-redaction",
+		"payload-redaction",
+		"payload-mutation",
+		"payload-toJSON",
+		"payload-getter",
+		"payload-null",
+		"missing-receipt",
+	]) {
+		it(`${api} native context honors final hooks: ${mode}`, async () => {
+			const model: Model<typeof api> = {
+				id: "synthetic-context-fixture",
+				name: "Synthetic",
+				provider: "openai",
+				api,
+				baseUrl: "https://fixture.invalid",
+				reasoning: false,
+				input: ["text"],
+				cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
+				contextWindow: 4096,
+				maxTokens: 128,
+			};
+			let serializedHooks = 0;
+			let calls = 0,
+				invocation: AgentToolInvocation | undefined,
+				view: AgentToolTextContext | undefined;
+			const order: string[] = [];
+			const tool: AgentTool = {
+				name: "context_probe",
+				label: "Context",
+				description: "Native bounded context fixture",
+				parameters: Type.Object({}),
+				execute: async () => {
+					throw Error("Native invocation required");
+				},
+				withInvocation: (native) => ({
+					...tool,
+					execute: async () => {
+						invocation = native;
+						view = native.getTextContext!();
+						return { content: [{ type: "text", text: "read" }], details: {} };
+					},
+				}),
+			};
+			const agent = new Agent({
+				initialState: {
+					model,
+					tools: [tool],
+					messages: [{ role: "user", content: "raw older ancestry", timestamp: 1 }],
+				},
+				transformContext: async (messages) => {
+					order.push("transform");
+					return messages
+						.filter((m) => m.role !== "user" || m.content !== "raw older ancestry")
+						.map((m) => (m.role === "user" ? { ...m, content: "hook-approved text" } : m));
+				},
+				convertToLlm: (messages) => {
+					order.push("convert");
+					return (messages as Message[]).map((m) =>
+						mode === "convert-redaction" && m.role === "user" ? { ...m, content: "conversion-redacted" } : m,
+					);
+				},
+				onPayload: (payload) => {
+					order.push("payload");
+					if (mode === "payload-redaction") return { input: [{ role: "user", content: "payload-redacted" }] };
+					if (mode === "payload-mutation") (payload as { input: unknown }).input = [];
+					if (mode === "payload-toJSON")
+						return {
+							...(payload as object),
+							toJSON() {
+								serializedHooks++;
+								return { input: [] };
+							},
+						};
+					if (mode === "payload-getter")
+						return {
+							get input() {
+								serializedHooks++;
+								return [];
+							},
+						};
+					if (mode === "payload-null") return null;
+					return undefined;
+				},
+				streamFn: async (requestModel, context, options) => {
+					const payload = {
+						input: convertResponsesMessages(requestModel, context, new Set(["openai", "openai-codex"])),
+					};
+					const replacement = await options?.onPayload?.(payload, requestModel);
+					const serialized = JSON.stringify(replacement === undefined ? payload : replacement);
+					if (mode !== "missing-receipt") options?.onSerializedRequest?.(serialized);
+					const first = calls++ === 0;
+					const message: AssistantMessage = {
+						role: "assistant",
+						api,
+						provider: model.provider,
+						model: model.id,
+						timestamp: 1,
+						content: first
+							? [{ type: "toolCall", id: "native-context-probe", name: "context_probe", arguments: {} }]
+							: [{ type: "text", text: "done" }],
+						stopReason: first ? "toolUse" : "stop",
+						usage: {
+							input: 0,
+							output: 0,
+							cacheRead: 0,
+							cacheWrite: 0,
+							totalTokens: 0,
+							cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 },
+						},
+					};
+					const stream = new EventStream<AssistantMessageEvent, AssistantMessage>(
+						(e) => e.type === "done",
+						() => message,
+					);
+					queueMicrotask(() => stream.push({ type: "done", reason: first ? "toolUse" : "stop", message }));
+					return stream;
+				},
+			});
+			try {
+				await agent.prompt("raw current text");
+				expect(calls).toBe(2);
+				expect(invocation).toBeDefined();
+				if (mode === "approved")
+					expect(view).toEqual([{ role: "user", content: [{ type: "text", text: "hook-approved text" }] }]);
+				else expect(view).toBeUndefined();
+				expect(() => invocation!.getTextContext!()).toThrow(/expired/);
+				expect(order.slice(0, 3)).toEqual(["transform", "convert", "payload"]);
+				if (mode === "payload-toJSON" || mode === "payload-getter") expect(serializedHooks).toBe(2);
+			} finally {
+				agent.invalidateToolInvocations();
+				agent.abort();
+				await agent.waitForIdle();
+			}
+		});
+	}
+}
