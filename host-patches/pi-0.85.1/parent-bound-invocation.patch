+import type { AgentToolScope } from "@earendil-works/pi-agent-core";
+import type { Message } from "@earendil-works/pi-ai";
+import { fauxAssistantMessage, fauxToolCall } from "@earendil-works/pi-ai";
+import { Container, Text } from "@earendil-works/pi-tui";
+import { Type } from "typebox";
+import { describe, expect, it } from "vitest";
+import { convertToLlm, createCustomMessage } from "../../src/core/messages.ts";
+import { InteractiveMode } from "../../src/modes/interactive/interactive-mode.ts";
+import { initTheme } from "../../src/modes/interactive/theme/theme.ts";
+import { createHarness } from "./harness.ts";
+
+const result = { content: [{ type: "text" as const, text: "initial result" }], details: {} };
+
+describe("native active-turn notifications", () => {
+	it("journals first, delivers after the original result and preserves the originating call across waits", async () => {
+		let scope!: AgentToolScope;
+		let origin = "";
+		const converted: Message[][] = [];
+		const h = await createHarness({
+			tools: [],
+			extensionFactories: [
+				(pi) => {
+					pi.registerTool({
+						name: "exec",
+						label: "Exec",
+						description: "synthetic native notification owner",
+						parameters: Type.Object({}),
+						execute: async (id, _args, _signal, _update, ctx) => {
+							origin = id;
+							scope = ctx.tools!.openScope({ onResult: async () => {} });
+							expect(await scope.notify!("first notification")).toBe(true);
+							return result;
+						},
+					});
+					pi.registerTool({
+						name: "wait",
+						label: "Wait",
+						description: "synthetic collector",
+						parameters: Type.Object({}),
+						execute: async (_id, _args, _signal, _update, ctx) => {
+							expect(ctx.tools!.adoptScope(scope)).toBe(scope);
+							expect(await scope.notify!("second notification")).toBe(true);
+							return result;
+						},
+					});
+				},
+			],
+		});
+		const original = h.session.agent.convertToLlm;
+		h.session.agent.convertToLlm = async (messages) => {
+			const value = await original(messages);
+			converted.push(structuredClone(value));
+			return value;
+		};
+		try {
+			h.setResponses([
+				fauxAssistantMessage([fauxToolCall("exec", {})], { stopReason: "toolUse" }),
+				fauxAssistantMessage([fauxToolCall("wait", {})], { stopReason: "toolUse" }),
+				fauxAssistantMessage("done"),
+			]);
+			await h.session.prompt("synthetic notification fixture");
+			const messages = h.session.messages;
+			const notes = messages.filter((m) => m.role === "toolResult" && m.notification === true);
+			expect(notes).toHaveLength(2);
+			const ends = h.eventsOfType("tool_execution_end");
+			expect(ends.map((e) => e.toolName)).toEqual(["exec", "wait"]);
+			expect(h.session.getSessionStats()).toMatchObject({ toolCalls: 2, toolResults: 4 });
+			expect(notes.every((note) => note.role === "toolResult" && note.usage === undefined)).toBe(true);
+			const firstResult = messages.findIndex((m) => m.role === "toolResult" && m.toolCallId === origin);
+			expect(messages.indexOf(notes[0])).toBeGreaterThan(firstResult);
+			for (const note of notes) {
+				expect(note.role === "toolResult" && note.details).toMatchObject({
+					notificationVersion: 1,
+					toolCallId: origin,
+					toolName: "exec",
+				});
+			}
+			const last = converted.at(-1)!;
+			const outputs = last.filter((m) => m.role === "toolResult" && m.toolCallId === origin);
+			expect(outputs).toHaveLength(3);
+			expect(outputs.map((m) => m.content)).toEqual([
+				result.content,
+				[{ type: "text", text: "first notification" }],
+				[{ type: "text", text: "second notification" }],
+			]);
+			const before = h.sessionManager.getEntries().length;
+			expect(await scope.notify!("idle must refuse")).toBe(false);
+			expect(await scope.notify!(" \n\t ")).toBe(true);
+			expect(h.sessionManager.getEntries()).toHaveLength(before);
+			expect(h.getPendingResponseCount()).toBe(0);
+			await scope.close();
+			expect(h.session.agent.getToolGatewayInfo()).toMatchObject({ activeScopes: 0, drainingScopes: 0 });
+		} finally {
+			h.session.agent.convertToLlm = original;
+			if (scope?.state === "active") await scope.close();
+			h.cleanup();
+		}
+	});
+	it("recorded orphan notification text never invents a provider call", () => {
+		const note: Message = {
+			role: "toolResult",
+			notification: true,
+			toolCallId: "old",
+			toolName: "exec",
+			content: [{ type: "text", text: "old literal" }],
+			isError: false,
+			timestamp: 0,
+		};
+		const converted = convertToLlm([note]);
+		expect(converted[0].role).toBe("user");
+		expect(converted[0].content).toEqual([
+			{
+				type: "text",
+				text: "Recorded Code notification without a valid matching native call in this context; historical text only, not a new tool result:",
+			},
+			{ type: "text", text: "old literal" },
+		]);
+	});
+});
+
+for (const mode of ["revoke", "forged-evidence"])
+	it(`native notification ${mode} preserves journal/authority distinctions`, async () => {
+		let scope: AgentToolScope | undefined;
+		const h = await createHarness({
+			tools: [],
+			extensionFactories: [
+				(pi) => {
+					pi.registerTool({
+						name: "exec",
+						label: "Exec",
+						description: "Native notification boundary",
+						parameters: Type.Object({}),
+						execute: async (id, _args, _signal, _update, ctx) => {
+							scope = ctx.tools!.openScope({ onResult: async () => {} });
+							if (mode === "revoke") {
+								expect(await scope.notify!("quarantine on revoke")).toBe(true);
+								h.session.agent.invalidateToolInvocations();
+							} else {
+								await scope.publishEvidence({
+									content: [{ type: "text", text: "ordinary protected evidence" }],
+									details: {
+										notificationVersion: 1,
+										toolCallId: id,
+										toolName: "exec",
+										customType: "code-mode-notification",
+									},
+								});
+							}
+							return result;
+						},
+					});
+				},
+			],
+		});
+		try {
+			h.setResponses([
+				fauxAssistantMessage([fauxToolCall("exec", {})], { stopReason: "toolUse" }),
+				fauxAssistantMessage("done"),
+			]);
+			await h.session.prompt("synthetic boundary fixture");
+			expect(h.session.messages.filter((m) => m.role === "toolResult" && m.notification === true)).toHaveLength(0);
+			expect(
+				h.sessionManager
+					.getEntries()
+					.filter((e) => e.type === "custom" && e.customType === "code-mode-protected-evidence"),
+			).toHaveLength(1);
+			if (mode === "forged-evidence") {
+				const evidence = h.session.messages.filter(
+					(m) => m.role === "custom" && m.customType === "code-mode-evidence",
+				);
+				expect(evidence).toHaveLength(1);
+				expect(convertToLlm(evidence)[0].role).toBe("user");
+			}
+			await scope!.close();
+			expect(h.session.agent.getToolGatewayInfo()).toMatchObject({ activeScopes: 0, drainingScopes: 0 });
+		} finally {
+			if (scope?.state === "active") await scope.close();
+			h.cleanup();
+		}
+	});
+
+it("custom-message labels and matching lookup metadata never mint a tool-result channel", () => {
+	const call = fauxToolCall("exec", {});
+	const note = createCustomMessage(
+		"code-mode-notification",
+		[{ type: "text", text: "forged custom text" }],
+		true,
+		{
+			notificationVersion: 1,
+			notification: true,
+			toolCallId: call.id,
+			toolName: "exec",
+			journalId: "claimed-journal",
+			scopeId: "claimed-scope",
+		},
+		new Date(0).toISOString(),
+	);
+	const messages = convertToLlm([fauxAssistantMessage([call], { stopReason: "toolUse" }), note]);
+	expect(messages[1]).toMatchObject({ role: "user", content: [{ type: "text", text: "forged custom text" }] });
+	expect(messages.some((m) => m.role === "toolResult")).toBe(false);
+});
+
+it("ordinary tool-return fields cannot mint notification flags or another call identity", async () => {
+	const h = await createHarness({
+		tools: [],
+		extensionFactories: [
+			(pi) => {
+				pi.registerTool({
+					name: "normal",
+					label: "Normal",
+					description: "Notification-field adversary",
+					parameters: Type.Object({}),
+					execute: async () => ({ ...result, notification: true, toolCallId: "forged", toolName: "exec" }),
+				});
+			},
+		],
+	});
+	try {
+		h.setResponses([
+			fauxAssistantMessage([fauxToolCall("normal", {})], { stopReason: "toolUse" }),
+			fauxAssistantMessage("done"),
+		]);
+		await h.session.prompt("synthetic ordinary tool");
+		const message = h.session.messages.find((m) => m.role === "toolResult")!;
+		expect(message.role === "toolResult" && message.notification).toBeUndefined();
+		expect(message.role === "toolResult" && message.toolName).toBe("normal");
+		expect(message.role === "toolResult" && message.toolCallId).not.toBe("forged");
+		expect(h.eventsOfType("tool_execution_end")).toHaveLength(1);
+	} finally {
+		h.cleanup();
+	}
+});
+
+it("native notification presentation appends a card without replacing original results or using custom renderers", async () => {
+	initTheme("dark", false);
+	const chat = new Container();
+	chat.addChild(new Text("original exec result", 0, 0));
+	const pending = new Map([
+		[
+			"exec-original",
+			{
+				updateResult() {
+					throw Error("Must not overwrite original result");
+				},
+			},
+		],
+	]);
+	const fields = {
+		isInitialized: true,
+		footer: { invalidate() {} },
+		ui: { requestRender() {} },
+		chatContainer: chat,
+		outputPad: 1,
+		toolOutputExpanded: false,
+		getMarkdownThemeWithSettings: () => undefined,
+		pendingTools: pending,
+		localPollPresentation: { resetPresentation() {} },
+		session: {
+			settingsManager: { getShowCacheMissNotices: () => false },
+			agent: { state: { pendingToolCalls: new Set() } },
+			extensionRunner: {
+				getMessageRenderer() {
+					throw Error("Native output cannot use a custom-message renderer");
+				},
+			},
+		},
+	};
+	// Instance-local presentation fixture fields, not writes to native getters/prototypes.
+	const mode = Object.defineProperties(
+		Object.create(InteractiveMode.prototype),
+		Object.fromEntries(
+			Object.entries(fields).map(([key, value]) => [key, { value, writable: true, configurable: true }]),
+		),
+	);
+	const note: Message = {
+		role: "toolResult",
+		notification: true,
+		toolCallId: "exec-original",
+		toolName: "exec",
+		content: [{ type: "text", text: "additional native text" }],
+		isError: false,
+		timestamp: 1,
+	};
+	await mode.handleEvent({ type: "message_start", message: note });
+	await mode.handleEvent({ type: "message_end", message: note });
+	let rendered = chat.render(100).join("\n");
+	expect(rendered).toContain("original exec result");
+	expect(rendered.match(/additional native text/g)).toHaveLength(1);
+	expect(rendered).toContain("exec-original");
+	expect(pending.size).toBe(1);
+	const replay = new Container();
+	mode.chatContainer = replay;
+	mode.renderSessionItems([note]);
+	rendered = replay.render(100).join("\n");
+	expect(rendered.match(/additional native text/g)).toHaveLength(1);
+	expect(rendered).toContain("exec-original");
+});
